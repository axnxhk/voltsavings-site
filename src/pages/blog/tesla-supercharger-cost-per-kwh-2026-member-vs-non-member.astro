        <!-- Home US EIA Average -->
        <tr class="hover:bg-gray-50 transition-colors">
          <td class="py-4 px-4 sm:px-6">
            <strong class="text-gray-950 block">🏠 US Residential Home Average (EIA)</strong>
            <span class="text-[11px] text-gray-500">US national residential rate + 10% Level 2 loss</span>
          </td>
          <td class="py-4 px-3 sm:px-4 text-center font-semibold text-gray-700">$0.182 / kWh</td>
          <td class="py-4 px-3 sm:px-4 text-right font-black text-gray-950">$10.01</td>
          <td class="py-4 px-3 sm:px-4 text-right font-black text-gray-950">$15.02</td>
          <td class="py-4 px-4 sm:px-6 text-right font-bold text-gray-800">5.71¢ / mi</td>
        </tr>

        <!-- Tesla Supercharger Member -->
        <tr class="bg-emerald-50/40 hover:bg-emerald-50/80 transition-colors">
          <td class="py-4 px-4 sm:px-6">
            <strong class="text-emerald-950 block">⚡ Supercharger Member / Tesla Owner</strong>
            <span class="text-[11px] text-emerald-700">All Tesla vehicles + $12.99/mo non-Tesla subscribers</span>
          </td>
          <td class="py-4 px-3 sm:px-4 text-center font-bold text-emerald-800">$0.420 / kWh</td>
          <td class="py-4 px-3 sm:px-4 text-right font-black text-emerald-950">$21.00</td>
          <td class="py-4 px-3 sm:px-4 text-right font-black text-emerald-950">$31.50</td>
          <td class="py-4 px-4 sm:px-6 text-right font-bold text-emerald-800">12.00¢ / mi</td>
        </tr>

        <!-- Tesla Supercharger Non-Member -->
        <tr class="bg-amber-50/40 hover:bg-amber-50/80 transition-colors">
          <td class="py-4 px-4 sm:px-6">
            <strong class="text-amber-950 block">⚠️ Supercharger Non-Member (PAYG)</strong>
            <span class="text-[11px] text-amber-700">Ford, Chevy, Rivian, Hyundai without membership</span>
          </td>
          <td class="py-4 px-3 sm:px-4 text-center font-bold text-amber-800">$0.580 / kWh</td>
          <td class="py-4 px-3 sm:px-4 text-right font-black text-amber-950">$29.00</td>
          <td class="py-4 px-3 sm:px-4 text-right font-black text-amber-950">$43.50</td>
          <td class="py-4 px-4 sm:px-6 text-right font-bold text-amber-900">16.57¢ / mi</td>
        </tr>

        <!-- Benchmark 30 MPG Gas Car @ $3.50 -->
        <tr class="bg-gray-50/80 border-t-2 border-gray-300">
          <td class="py-4 px-4 sm:px-6">
            <strong class="text-gray-950 block">⛽ 30 MPG Gas Car (@ $3.50 / Gallon)</strong>
            <span class="text-[11px] text-gray-500">US national average gas pump price</span>
          </td>
