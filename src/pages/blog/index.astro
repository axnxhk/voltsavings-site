---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const articles = [
  {
    slug: 'ev-bikes-2026',
    title: 'Are Electric Motorcycles Worth It in 2026?',
    desc: 'With surging petrol rates, electric bikes claim up to 80% operational cost reduction. We break down initial purchase price vs recurring savings.',
    category: 'Economics',
    badgeClass: 'bg-emerald-100 text-emerald-800'
  },
  {
    slug: 'ev-savings-2026',
    title: 'How Much Do You Save Switching to an EV?',
    desc: 'Discover exactly how much money you can save by switching from a gas engine to an electric vehicle, factoring in fuel and routine maintenance.',
    category: 'Cost Analysis',
    badgeClass: 'bg-emerald-100 text-emerald-800'
  },
  {
    slug: 'ev-battery-life-2026',
    title: 'EV Battery Lifespan & Maintenance Guide',
    desc: 'Learn how to prevent battery degradation, understand LFP battery lifecycles, and maximize your electric vehicle longevity under hot climates.',
    category: 'Maintenance',
    badgeClass: 'bg-emerald-100 text-emerald-800'
  }
];
---

<Layout 
  title="EV Research, Guides & Cost Analysis Blog | VoltSavings™"
  description="Read our latest data-driven research and practical advice on electric vehicles, charging costs, battery maintenance, and commuting economics."
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full flex-grow">
    
    <!-- Semantic Breadcrumbs -->
    <Breadcrumbs items={[
      { name: 'Home', url: '/' },
      { name: 'Blog' }
    ]} />

    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-xs font-black uppercase tracking-wider text-emerald-600">Commuter Intelligence</span>
      <h1 class="text-4xl sm:text-5xl font-black text-black tracking-tight mt-3 mb-4">Electric Mobility Guides & Analysis</h1>
      <p class="text-sm sm:text-base text-gray-600 font-medium">Data-driven research and practical advice to help you maximize your savings while transitioning to clean energy vehicles.</p>
    </div>

    <!-- Blog Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {articles.map((art) => (
        <article class="bg-white border-2 border-gray-100 rounded-2xl overflow-hidden hover:border-emerald-300 transition shadow-sm flex flex-col">
          <div class="p-6 border-b border-gray-100 bg-emerald-50/50">
            <span class={`inline-block px-2.5 py-1 rounded-md text-[10px] font-black uppercase mb-3 ${art.badgeClass}`}>
              {art.category}
            </span>
            <h2 class="text-xl font-black text-black leading-snug">
              <a href={`/blog/${art.slug}`} class="hover:text-emerald-600 transition-colors">
                {art.title}
              </a>
            </h2>
          </div>
          <div class="p-6 flex flex-col flex-grow justify-between">
            <p class="text-sm text-gray-600 leading-relaxed mb-6 font-medium">
              {art.desc}
            </p>
            <a 
              href={`/blog/${art.slug}`} 
              class="text-sm font-black text-emerald-600 hover:text-emerald-700 flex items-center gap-2 group transition-colors"
            >
              Read Full Guide <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Calculator CTA Banner -->
    <div class="mt-16 bg-emerald-50 border-2 border-emerald-200 rounded-3xl p-8 text-center max-w-4xl mx-auto">
      <h3 class="text-2xl font-black text-black mb-2">Ready to crunch your own commuting numbers?</h3>
      <p class="text-sm text-gray-700 mb-6 font-medium">Use our 100% free, private calculator with real-time currency and local electricity tariff support.</p>
      <a 
        href="/#calculator-app" 
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-md shadow-emerald-600/25 transition-all"
      >
        Open Free EV Calculator <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>

  </main>
</Layout>
