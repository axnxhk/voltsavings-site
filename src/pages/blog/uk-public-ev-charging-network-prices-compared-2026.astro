  category="UK EV Economics"
  updatedDate="Updated Nov 2026"
  publishedTime="2026-11-15T09:00:00Z"
  modifiedTime="2026-11-15T09:00:00Z"
  author="John"
  currentSlug="uk-public-ev-charging-network-prices-compared-2026"
