        </tr>
        <tr>
          <td class="p-3.5 font-bold text-gray-950">Fastned (Canopied Yellow Stations)</td>
          <td class="p-3.5">300 kW</td>
          <td class="p-3.5">79.0p / kWh</td>
          <td class="p-3.5">£30.34</td>
          <td class="p-3.5">22.5p / mile</td>
        </tr>
        <tr class="bg-amber-50/40">
