          <td class="p-3.5 font-bold text-amber-900">23.4p / mile</td>
        </tr>
        <tr class="bg-red-50/50">
          <td class="p-3.5 font-bold text-red-950">InstaVolt (Contactless Rapid Hubs)</td>
          <td class="p-3.5">160 kW</td>
          <td class="p-3.5 font-black text-red-700">87.0p / kWh</td>
          <td class="p-3.5 font-bold text-red-900">£33.41</td>
          <td class="p-3.5 font-black text-red-700">24.8p / mile</td>
        </tr>
        <tr class="bg-red-50/70 border-b-2 border-red-200">
