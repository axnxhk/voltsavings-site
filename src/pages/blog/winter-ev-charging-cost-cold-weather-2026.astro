const winterFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does cold weather increase EV charging costs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Cold winter weather increases electric vehicle charging costs by 20% to 35% in freezing temperatures (below 32°F / 0°C). In the US, driving 1,000 miles in winter on national average electricity ($0.182/kWh) costs approximately $75.53 per month compared to $52.60 in mild summer weather—an added cost of roughly $22.93 per month (or 2.3¢ more per mile). In the UK, winter charging on the standard Ofgem price cap (26.32p/kWh) adds approximately £33.17 per month (£109.23 vs £76.06 in summer)."
      }
    },
    {
      "@type": "Question",
      "name": "Why do electric cars use more electricity in freezing winter temperatures?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Electric cars lose efficiency in winter primarily due to cabin climate control and battery chemistry. Unlike internal combustion engines that waste 70% of fuel energy as heat, EVs are 90% efficient and must draw 3 to 6 kW of battery power for cabin heating. Additionally, cold temperatures thicken lithium-ion electrolyte, increasing internal cell resistance, reducing regenerative braking, and forcing the Battery Management System (BMS) to expend energy warming the pack to optimal operating temperatures (60°F–77°F / 15°C–25°C)."
      }
    },
    {
      "@type": "Question",
      "name": "Is it cheaper to drive an EV in winter compared to a gas or petrol car?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Even during sub-freezing winter conditions, driving an EV remains significantly cheaper than a comparable gas or petrol vehicle. While an EV's winter running cost rises to approximately 7.5¢/mile in the US, a 28 MPG gas SUV whose fuel economy drops to 24 MPG in winter costs roughly 14.6¢/mile at $3.50/gallon—meaning an EV still saves over $70 per month on fuel. In the UK, charging on an off-peak smart tariff (such as Intelligent Octopus Go at 7p/kWh) costs only 2.9p/mile in freezing winter, saving over £160 per month compared to a 34 MPG petrol car at £1.42/litre (19.0p/mile)."
      }
    },
    {
      "@type": "Question",
      "name": "How can I reduce winter EV charging costs and preserve driving range?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To cut winter charging costs: 1) Precondition your cabin and battery pack while still connected to grid power so initial warming draws from the wall rather than your battery; 2) Rely on heated seats and steering wheel warmers, which consume just 50 to 100 watts compared to 3,000 to 5,000 watts for forced-air climate systems; 3) Charge immediately after arriving home while the battery is still chemically warm; 4) Check tire pressure monthly, as freezing temperatures decrease pressure by ~1 PSI per 10°F drop; and 5) Schedule charging during overnight off-peak utility hours."
      }
    },
    {
      "@type": "Question",
      "name": "Do Level 2 home chargers have higher efficiency losses in freezing temperatures?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. In moderate weather (65°F to 75°F / 18°C to 24°C), AC-to-DC Level 2 charging efficiency loss is typically 8% to 10%. In sub-freezing conditions (under 20°F / -7°C), charging losses expand to 12% to 15%. This occurs because the vehicle's onboard charger and battery thermal management system divert an initial 1 to 2.5 kWh of grid power directly into warming cold battery cells before rapid lithium intercalation can safely proceed."
      }
    }
  ]
};
