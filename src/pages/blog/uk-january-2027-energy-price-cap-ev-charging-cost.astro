const ukPriceCapFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much will it cost to charge an electric car under the January 2027 Ofgem price cap?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Under the forecast January–March 2027 Ofgem energy price cap of approximately 32.54p per kWh, fully charging a typical 60 kWh electric car at home (requiring 66 kWh from the grid factoring in 10% AC onboard charging losses) will cost £21.48. This represents a £4.11 increase (+23.6%) compared to the late-2026 price cap rate of 26.32p/kWh (£17.37). For an EV achieving a real-world winter efficiency of 3.5 miles per kWh, driving costs will climb from 8.3p to 10.2p per mile."
      }
    },
    {
      "@type": "Question",
      "name": "Is driving an electric car still cheaper than petrol in the UK at 32.5p/kWh?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Even under the elevated standard variable tariff of 32.54p/kWh, driving an electric vehicle costs 10.2p per mile, making it 45% cheaper to run than a standard 40 MPG petrol car at 18.4p per mile (based on RAC November 2026 petrol averages of 161.6p/litre). For an average UK commuter driving 8,000 miles per year, an EV on the standard January 2027 price cap still saves approximately £656 annually compared to petrol. Furthermore, switching to an overnight smart EV tariff (6.5p/kWh) slashes running costs to just 2.0p per mile, boosting annual savings over petrol to £1,312."
      }
    },
    {
      "@type": "Question",
      "name": "Do smart EV tariffs like Intelligent Octopus Go and E.ON Next Drive rise with the Ofgem price cap?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Not necessarily. Dedicated overnight smart EV tariffs (such as Intelligent Octopus Go at 6.5p/kWh and E.ON Next Drive Smart at 6.5p/kWh) are set commercially by energy suppliers to incentivize nighttime grid balancing and are not directly bound to Ofgem's standard variable default tariff price cap. While daytime peak electricity rates on these dual-rate tariffs may adjust slightly with wholesale market conditions, energy suppliers generally fix off-peak EV charging windows for 12 months, shielding smart EV drivers from seasonal price cap hikes."
      }
    },
    {
      "@type": "Question",
      "name": "What is the cheapest way to charge an electric vehicle in the UK in 2027?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The cheapest way to charge is at home overnight using a dedicated time-of-use smart EV tariff paired with a smart 7 kW home wallbox. Modern smart tariffs such as Intelligent Octopus Go (6.5p/kWh between 23:30 and 05:30) and E.ON Next Drive Smart (6.5p/kWh between 00:00 and 06:00) allow you to fully charge a 60 kWh battery pack for only £4.29 (2.0p/mile)—which is 80% cheaper than the January 2027 Ofgem default price cap and nearly 90% cheaper than fueling a petrol vehicle."
      }
    },
    {
      "@type": "Question",
      "name": "Why do public rapid chargers cost more per mile than petrol in the UK?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Public DC rapid and ultra-rapid chargers (50 kW to 350 kW) average approximately 79p/kWh across the UK. At 3.5 miles/kWh, public rapid charging costs 22.6p per mile, which is more expensive than fueling an average petrol car (18.4p/mile). Charging network operators must absorb heavy commercial electricity standing charges, peak-demand energy surcharges, high capital costs for high-voltage grid connections, and a 20% commercial VAT rate (compared to 0% domestic VAT on home charging through March 2027). EV experts strongly advise following the 80/20 charging rule: complete 80%+ of charging at home on off-peak rates and reserve public rapid chargers for long-distance motorway travel."
      }
    }
  ]
};
