  updatedDate="Updated Nov 2026"
  publishedTime="2026-11-15T08:00:00Z"
  modifiedTime="2026-11-15T08:00:00Z"
  author="John"
  currentSlug="chevy-equinox-ev-charging-cost-at-home-us"
