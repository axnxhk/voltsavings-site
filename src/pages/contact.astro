---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact VoltSavings",
  "description": "Get in touch with the VoltSavings team for technical support, methodology inquiries, fleet calculation partnerships, or feedback on our EV savings tools."
};
---

<Layout 
  title="Contact Us & Support Hub | VoltSavings™"
  description="Have questions about our EV vs Petrol calculation formulas or want to partner with us? Contact the VoltSavings team for prompt assistance."
  schema={contactSchema}
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16 w-full flex-grow">
    
    <Breadcrumbs items={[
      { name: 'Home', url: '/' },
      { name: 'Contact' }
    ]} />

    <div class="bg-white border-2 border-gray-200 rounded-3xl p-8 sm:p-12 shadow-sm">
      
      <!-- Page Header -->
      <div class="mb-10 border-b border-gray-200 pb-8 text-center sm:text-left">
        <span class="text-xs font-black uppercase tracking-wider text-emerald-600">GET IN TOUCH</span>
        <h1 class="text-3xl sm:text-4xl font-black text-gray-950 tracking-tight mt-2">Contact & Support Hub</h1>
        <p class="text-sm text-gray-600 mt-2 font-medium">
          Have questions regarding our calculation methodology, vehicle presets, or business partnerships? We're here to help.
        </p>
      </div>

      <!-- Contact Options Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-12 not-prose">
        
        <!-- General Inquiries -->
        <div class="p-6 rounded-2xl bg-gray-50 border-2 border-gray-200 hover:border-emerald-400 transition-all">
          <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center text-lg mb-4 font-bold">
            <i class="fa-solid fa-envelope"></i>
          </div>
          <strong class="text-base font-black text-gray-950 block mb-1">General Inquiries & Feedback</strong>
          <p class="text-xs text-gray-600 mb-4 leading-relaxed font-medium">
            For general questions, calculator feedback, or user experience suggestions:
          </p>
          <a href="mailto:support@voltsavings.com" class="text-xs font-black text-emerald-700 hover:text-emerald-800 flex items-center gap-1.5">
            support@voltsavings.com <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
          </a>
        </div>

        <!-- Technical & Methodology Audits -->
        <div class="p-6 rounded-2xl bg-gray-50 border-2 border-gray-200 hover:border-emerald-400 transition-all">
          <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center text-lg mb-4 font-bold">
            <i class="fa-solid fa-square-root-variable"></i>
          </div>
          <strong class="text-base font-black text-gray-950 block mb-1">Methodology & Research Audits</strong>
          <p class="text-xs text-gray-600 mb-4 leading-relaxed font-medium">
            For automotive researchers, journalists, or fleet managers reviewing our formulas:
          </p>
          <a href="/methodology" class="text-xs font-black text-emerald-700 hover:text-emerald-800 flex items-center gap-1.5">
            Inspect Calculation Methodology <i class="fa-solid fa-arrow-right text-[10px]"></i>
          </a>
        </div>

        <!-- Fleet & Business Inquiries -->
        <div class="p-6 rounded-2xl bg-gray-50 border-2 border-gray-200 hover:border-emerald-400 transition-all">
          <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center text-lg mb-4 font-bold">
            <i class="fa-solid fa-truck-ramp-box"></i>
          </div>
          <strong class="text-base font-black text-gray-950 block mb-1">Commercial Fleets & Delivery Couriers</strong>
          <p class="text-xs text-gray-600 mb-4 leading-relaxed font-medium">
            Interested in customized multi-vehicle fleet calculators for logistics and couriers:
          </p>
          <a href="mailto:business@voltsavings.com" class="text-xs font-black text-emerald-700 hover:text-emerald-800 flex items-center gap-1.5">
            business@voltsavings.com <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
          </a>
        </div>

        <!-- Privacy & Security -->
        <div class="p-6 rounded-2xl bg-gray-50 border-2 border-gray-200 hover:border-emerald-400 transition-all">
          <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center text-lg mb-4 font-bold">
            <i class="fa-solid fa-shield-halved"></i>
          </div>
          <strong class="text-base font-black text-gray-950 block mb-1">Data Privacy & Compliance</strong>
          <p class="text-xs text-gray-600 mb-4 leading-relaxed font-medium">
            Learn how we safeguard user privacy through 100% client-side computing:
          </p>
          <a href="/privacy-policy" class="text-xs font-black text-emerald-700 hover:text-emerald-800 flex items-center gap-1.5">
            Read Privacy Policy <i class="fa-solid fa-arrow-right text-[10px]"></i>
          </a>
        </div>

      </div>

      <!-- Quick Self-Service FAQ -->
      <div class="border-t border-gray-200 pt-8 mb-10">
        <h2 class="text-xl font-black text-gray-950 mb-4">Quick Answers Before You Email</h2>
        <div class="space-y-3 text-xs text-gray-700 font-medium leading-relaxed">
          <div class="p-4 rounded-xl bg-gray-50 border border-gray-200">
            <strong class="text-gray-950 block mb-1">Q: Does VoltSavings save my commuting inputs?</strong>
            <span>No. All arithmetic formulas run entirely in your local browser window. No data is stored on remote servers.</span>
          </div>
          <div class="p-4 rounded-xl bg-gray-50 border border-gray-200">
            <strong class="text-gray-950 block mb-1">Q: Can I use this tool for commercial motorcycle delivery fleets?</strong>
            <span>Yes. Use our 'Electric Bike' preset or customize the daily mileage up to 100+ km for high-mileage courier analysis.</span>
          </div>
          <div class="p-4 rounded-xl bg-gray-50 border border-gray-200">
            <strong class="text-gray-950 block mb-1">Q: How do I generate an official printable report?</strong>
            <span>In the calculator results section, simply click the 'Download PDF Report' button to trigger our executive print stylesheet.</span>
          </div>
        </div>
      </div>

      <!-- Action Card -->
      <div class="p-6 bg-emerald-50 border-2 border-emerald-300 rounded-2xl flex flex-wrap gap-4 items-center justify-between">
        <div>
          <strong class="text-sm font-black text-emerald-950 block">Ready to calculate your commute?</strong>
          <span class="text-xs text-emerald-800 font-medium">Free, independent, and instant.</span>
        </div>
        <a 
          href="/#calculator-app" 
          class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-black shadow-md transition-all"
        >
          Open Free Calculator →
        </a>
      </div>

    </div>
  </main>
</Layout>
