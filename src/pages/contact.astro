---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact VoltSavings",
  "description": "Get in touch with the VoltSavings team for support, business inquiries, or questions about our EV vs Petrol cost savings calculator."
};
---

<Layout 
  title="Contact Us | VoltSavings™"
  description="Get in touch with the VoltSavings team for support, business inquiries, or questions about our EV vs Petrol cost savings calculator."
  schema={contactSchema}
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16 w-full flex-grow">
    
    <Breadcrumbs items={[
      { name: 'Home', url: '/' },
      { name: 'Contact' }
    ]} />

    <div class="bg-white border-2 border-gray-100 rounded-3xl p-8 sm:p-12 shadow-sm text-center">
      <div class="mb-8 border-b border-gray-100 pb-6">
        <span class="text-xs font-black uppercase tracking-wider text-emerald-600">Get In Touch</span>
        <h1 class="text-3xl sm:text-4xl font-black text-black tracking-tight mt-2">Contact Us</h1>
      </div>
      <div class="space-y-6 text-sm sm:text-base text-gray-600 font-medium leading-relaxed max-w-xl mx-auto">
        <p>We'd love to hear from you. Whether you have questions regarding our calculation methodology, need support, or wish to explore a partnership, feel free to reach out directly.</p>
        
        <div class="inline-flex items-center gap-3 bg-emerald-50 px-6 py-4 rounded-2xl border border-emerald-200 mt-6 shadow-sm">
          <i class="fa-solid fa-envelope text-emerald-600 text-xl"></i>
          <a href="mailto:support@voltsavings.com" class="text-lg font-black text-emerald-800 hover:text-emerald-600 transition-colors">
            support@voltsavings.com
          </a>
        </div>
        
        <p class="text-xs text-gray-500 mt-6 font-medium">We typically respond to inquiries within 24 to 48 business hours.</p>
      </div>
    </div>
  </main>
</Layout>
