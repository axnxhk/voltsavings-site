---
const currentPath = Astro.url.pathname;

const isCalculator = currentPath === '/' || currentPath === '';
const isBlog = currentPath.startsWith('/blog');
const isAbout = currentPath.startsWith('/about');
const isContact = currentPath.startsWith('/contact');
---

<header class="border-b border-gray-100 bg-white sticky top-0 z-50 shadow-sm" role="banner">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    
    <!-- Logo -->
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-2 group" aria-label="VoltSavings Home">
        <img src="/favicon.svg" alt="VoltSavings Logo" class="w-9 h-9 sm:w-10 sm:h-10 group-hover:scale-105 transition-transform flex-shrink-0 drop-shadow-sm" width="40" height="40" />
        <div>
          <div class="flex items-center gap-1.5">
            <span class="text-lg sm:text-xl font-black tracking-tight text-black">VoltSavings</span>
            <span class="inline-flex items-center px-1.5 py-0.2 rounded text-[9px] sm:text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">PRO</span>
          </div>
          <p class="text-[10px] sm:text-[11px] text-gray-500 font-medium hidden sm:block">Global Fuel vs EV Intelligence</p>
        </div>
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-8 text-sm font-bold text-gray-900" aria-label="Main Navigation">
      <a 
        href="/" 
        class={`py-2 transition-colors flex items-center gap-1.5 ${isCalculator ? 'text-emerald-600 font-black' : 'hover:text-emerald-600 text-gray-700'}`}
        aria-current={isCalculator ? 'page' : undefined}
      >
        Calculator {isCalculator && <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>}
      </a>
      <a 
        href="/blog" 
        class={`py-2 transition-colors flex items-center gap-1.5 ${isBlog ? 'text-emerald-600 font-black' : 'hover:text-emerald-600 text-gray-700'}`}
        aria-current={isBlog ? 'page' : undefined}
      >
        Blog {isBlog && <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>}
      </a>
      <a 
        href="/about" 
        class={`py-2 transition-colors flex items-center gap-1.5 ${isAbout ? 'text-emerald-600 font-black' : 'hover:text-emerald-600 text-gray-700'}`}
        aria-current={isAbout ? 'page' : undefined}
      >
        About Us {isAbout && <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>}
      </a>
      <a 
        href="/contact" 
        class={`py-2 transition-colors flex items-center gap-1.5 ${isContact ? 'text-emerald-600 font-black' : 'hover:text-emerald-600 text-gray-700'}`}
        aria-current={isContact ? 'page' : undefined}
      >
        Contact {isContact && <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>}
      </a>
    </nav>

    <!-- Right Action -->
    <div class="flex items-center gap-2 sm:gap-3">
      <a 
        href="/#calculator-app" 
        class="hidden sm:inline-flex items-center justify-center px-4 sm:px-5 py-2.5 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-md shadow-emerald-600/25 transition-all"
      >
        Try Calculator
      </a>
      <button 
        type="button"
        aria-label="Toggle Navigation Menu" 
        aria-expanded="false"
        id="mobileMenuBtn" 
        class="md:hidden text-black p-2.5 min-w-[44px] min-h-[44px] flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-emerald-600 rounded-xl border border-gray-200"
      >
        <i id="mobileMenuIcon" class="fa-solid fa-bars text-lg"></i>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobileMenu" class="hidden md:hidden border-t border-gray-100 bg-white/95 backdrop-blur-md px-4 py-5 space-y-2 text-sm shadow-xl transition-all animate-fadeIn">
    <a 
      href="/" 
      class={`mobile-link flex items-center justify-between py-2.5 px-3 rounded-xl font-bold min-h-[44px] ${isCalculator ? 'bg-emerald-50 text-emerald-700 font-black' : 'text-gray-800 hover:bg-gray-50'}`}
    >
      <span>⚡ EV Calculator</span>
      {isCalculator && <span class="w-2 h-2 rounded-full bg-emerald-600"></span>}
    </a>
    <a href="/#features" class="mobile-link block py-2.5 px-3 rounded-xl text-gray-700 hover:bg-gray-50 font-semibold min-h-[44px]">
      Key Features
    </a>
    <a href="/#breakdown" class="mobile-link block py-2.5 px-3 rounded-xl text-gray-700 hover:bg-gray-50 font-semibold min-h-[44px]">
      Comparison & 5-Year Matrix
    </a>
    <a 
      href="/blog" 
      class={`mobile-link flex items-center justify-between py-2.5 px-3 rounded-xl font-bold min-h-[44px] ${isBlog ? 'bg-emerald-50 text-emerald-700 font-black' : 'text-gray-800 hover:bg-gray-50'}`}
    >
      <span>📚 EV Guides & Research</span>
      {isBlog && <span class="w-2 h-2 rounded-full bg-emerald-600"></span>}
    </a>
    <a href="/#faq" class="mobile-link block py-2.5 px-3 rounded-xl text-gray-700 hover:bg-gray-50 font-semibold min-h-[44px]">
      Help & FAQ
    </a>
    <a 
      href="/about" 
      class={`mobile-link block py-2.5 px-3 rounded-xl font-semibold min-h-[44px] ${isAbout ? 'bg-emerald-50 text-emerald-700 font-black' : 'text-gray-700 hover:bg-gray-50'}`}
    >
      About Our Mission
    </a>
    <a 
      href="/contact" 
      class={`mobile-link block py-2.5 px-3 rounded-xl font-semibold min-h-[44px] ${isContact ? 'bg-emerald-50 text-emerald-700 font-black' : 'text-gray-700 hover:bg-gray-50'}`}
    >
      Contact Support
    </a>

    <!-- Mobile Menu CTA Button -->
    <div class="pt-3 border-t border-gray-100">
      <a 
        href="/#calculator-app" 
        class="mobile-link w-full py-3 px-4 rounded-xl text-center text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-md flex items-center justify-center gap-2 min-h-[44px]"
      >
        <i class="fa-solid fa-calculator"></i> Launch Free Calculator
      </a>
    </div>
  </div>
</header>

<script>
  const mobileBtn = document.getElementById('mobileMenuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  const mobileMenuIcon = document.getElementById('mobileMenuIcon');

  function toggleMenu() {
    if (!mobileMenu || !mobileBtn || !mobileMenuIcon) return;
    const isHidden = mobileMenu.classList.contains('hidden');
    if (isHidden) {
      mobileMenu.classList.remove('hidden');
      mobileBtn.setAttribute('aria-expanded', 'true');
      mobileMenuIcon.className = 'fa-solid fa-xmark text-lg';
    } else {
      mobileMenu.classList.add('hidden');
      mobileBtn.setAttribute('aria-expanded', 'false');
      mobileMenuIcon.className = 'fa-solid fa-bars text-lg';
    }
  }

  mobileBtn?.addEventListener('click', toggleMenu);

  // Close mobile menu automatically when any link is clicked
  document.querySelectorAll('.mobile-link').forEach(link => {
    link.addEventListener('click', () => {
      if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
        toggleMenu();
      }
    });
  });
</script>
