---
---

<div id="executiveReportPrint" class="bg-white text-slate-900 font-sans print-only">
  
  <!-- 1. Executive Document Header -->
  <div class="flex items-center justify-between pb-3 border-b-2 border-emerald-600 mb-3">
    <div class="flex items-center gap-3">
      <img src="/icon-192.png?v=6" alt="VoltSavings Logo" class="w-12 h-12 flex-shrink-0" width="48" height="48" />
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xl font-black tracking-tight text-slate-950">VoltSavings</span>
          <span class="px-1.5 py-0.5 rounded text-[9px] font-extrabold bg-emerald-100 text-emerald-800 border border-emerald-300">EXECUTIVE AUDIT</span>
        </div>
        <p class="text-[10px] text-slate-500 font-semibold tracking-wide">Global Commuter Financial Intelligence & Clean Mobility Analytics</p>
      </div>
    </div>
    
    <div class="text-right text-[10px] text-slate-600 font-medium space-y-0.5">
      <div><span class="text-slate-400">REPORT ID:</span> <strong id="repId" class="text-slate-950 font-mono">VS-2026-784102</strong></div>
      <div><span class="text-slate-400">DATE:</span> <strong id="repDate" class="text-slate-950">October 30, 2026</strong></div>
      <div><span class="text-slate-400">ENGINE:</span> <strong class="text-emerald-700 font-bold">v7.4 Client-Side Verified</strong></div>
    </div>
  </div>

  <!-- 2. Document Title Banner -->
  <div class="bg-slate-900 text-white p-3 rounded-xl mb-3 flex items-center justify-between">
    <div>
      <h1 class="text-sm font-black uppercase tracking-wider text-emerald-400">Official Operational Expenditure & Savings Audit</h1>
      <p class="text-[10px] text-slate-300 font-medium">5-Year Total Cost of Ownership (TCO) & Discretionary Cash Flow Forecast</p>
    </div>
    <div class="text-right text-[9px] font-bold uppercase bg-emerald-600 text-white px-2.5 py-1 rounded-lg">
      100% Unbiased & Independent
    </div>
  </div>

  <!-- 3. Baseline Assumptions Matrix (4 Clean Columns) -->
  <div class="mb-3">
    <div class="text-[9px] font-black uppercase tracking-wider text-slate-500 mb-1.5">1. Baseline Commute & Energy Parameters</div>
    <div class="grid grid-cols-4 gap-2">
      <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200">
        <span class="text-[9px] font-bold text-slate-400 block uppercase">Daily Commute</span>
        <div id="repCommute" class="text-xs font-black text-slate-950">45 km / day</div>
        <span id="repMonthlyDist" class="text-[9px] text-slate-500 block">1,170 km / mo (26 days)</span>
      </div>
      <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200">
        <span class="text-[9px] font-bold text-slate-400 block uppercase">Vehicle Segment</span>
        <div id="repPreset" class="text-xs font-black text-slate-950">Compact Sedan</div>
        <span id="repCurrency" class="text-[9px] text-slate-500 block">Currency: USD ($)</span>
      </div>
      <div class="p-2.5 rounded-lg bg-red-50/50 border border-red-200">
        <span class="text-[9px] font-bold text-red-700 block uppercase">Petrol Vehicle Model</span>
        <div id="repFuelEff" class="text-xs font-black text-red-950">14.0 km/L</div>
        <span id="repFuelPrice" class="text-[9px] text-red-700 block">Rate: $3.80/L | Maint: $30/mo</span>
      </div>
      <div class="p-2.5 rounded-lg bg-emerald-50/50 border border-emerald-200">
        <span class="text-[9px] font-bold text-emerald-700 block uppercase">Electric Vehicle Model</span>
        <div id="repEvEff" class="text-xs font-black text-emerald-950">6.5 km/kWh</div>
        <span id="repPowerRate" class="text-[9px] text-emerald-700 block">Rate: $0.18/kWh | Maint: $10/mo</span>
      </div>
    </div>
  </div>

  <!-- 4. Monthly Operational Delta (The Financial Winner) -->
  <div class="mb-3">
    <div class="text-[9px] font-black uppercase tracking-wider text-slate-500 mb-1.5">2. Monthly Operational Expenditure Delta</div>
    <div class="grid grid-cols-3 gap-2 p-3 rounded-xl bg-slate-50 border-2 border-slate-200">
      <div class="text-center p-2 rounded-lg bg-white border border-slate-200">
        <span class="text-[9px] font-bold text-slate-500 block uppercase">Monthly Petrol Outflow</span>
        <div id="repFuelMo" class="text-base font-black text-red-600 my-0.5">$347.57</div>
        <span id="repFuelKm" class="text-[9px] font-semibold text-slate-500 block">$0.30 per kilometer</span>
      </div>
      <div class="text-center p-2 rounded-lg bg-white border border-slate-200">
        <span class="text-[9px] font-bold text-slate-500 block uppercase">Monthly EV Charging Outflow</span>
        <div id="repEvMo" class="text-base font-black text-slate-800 my-0.5">$42.40</div>
        <span id="repEvKm" class="text-[9px] font-semibold text-slate-500 block">$0.04 per kilometer</span>
      </div>
      <div class="text-center p-2 rounded-lg bg-emerald-50 border-2 border-emerald-400">
        <span class="text-[9px] font-bold text-emerald-800 block uppercase">Net Discretionary Cash Saved</span>
        <div id="repSaveMo" class="text-base font-black text-emerald-700 my-0.5">+$305.17</div>
        <span id="repPctSave" class="text-[9px] font-extrabold text-emerald-800 bg-emerald-200/80 px-2 py-0.2 rounded-full inline-block">~88% COST REDUCTION</span>
      </div>
    </div>
  </div>

  <!-- 5. Multi-Year Compounding ROI Matrix Table -->
  <div class="mb-3">
    <div class="text-[9px] font-black uppercase tracking-wider text-slate-500 mb-1.5">3. Multi-Year Cumulative Cash Flow Projections</div>
    <div class="overflow-hidden rounded-xl border border-slate-300">
      <table class="w-full text-[10px] text-left border-collapse">
        <thead class="bg-slate-100 text-slate-900 font-black uppercase text-[9px] border-b border-slate-300">
          <tr>
            <th class="p-2">Time Horizon</th>
            <th class="p-2 text-red-700">Petrol Total Burn</th>
            <th class="p-2 text-slate-700">EV Total Power</th>
            <th class="p-2 text-emerald-800 font-black">Net Cash Retained in Wallet</th>
            <th class="p-2 text-slate-600">Tailpipe CO₂ Eliminated</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 font-medium">
          <tr class="bg-white">
            <td class="p-2 font-bold text-slate-900">1 Month (30 Days)</td>
            <td id="repTblFuel1M" class="p-2 text-red-700">$348</td>
            <td id="repTblEv1M" class="p-2 text-slate-700">$42</td>
            <td id="repTblSave1M" class="p-2 text-emerald-700 font-black">+$305</td>
            <td id="repTblCo21M" class="p-2 text-slate-600">~180 kg CO₂</td>
          </tr>
          <tr class="bg-emerald-50/40">
            <td class="p-2 font-bold text-slate-900">1 Year (12 Months)</td>
            <td id="repTblFuel1Y" class="p-2 text-red-700">$4,171</td>
            <td id="repTblEv1Y" class="p-2 text-slate-700">$509</td>
            <td id="repTblSave1Y" class="p-2 text-emerald-700 font-black">+$3,662</td>
            <td id="repTblCo21Y" class="p-2 text-slate-600">~2.2 Tonnes CO₂</td>
          </tr>
          <tr class="bg-white">
            <td class="p-2 font-bold text-slate-900">3 Years (36 Months)</td>
            <td id="repTblFuel3Y" class="p-2 text-red-700">$12,513</td>
            <td id="repTblEv3Y" class="p-2 text-slate-700">$1,526</td>
            <td id="repTblSave3Y" class="p-2 text-emerald-700 font-black">+$10,986</td>
            <td id="repTblCo23Y" class="p-2 text-slate-600">~6.5 Tonnes CO₂</td>
          </tr>
          <tr class="bg-emerald-100/60 font-semibold border-t-2 border-emerald-300">
            <td class="p-2 font-black text-slate-950">5 Years (60 Months Break-Even)</td>
            <td id="repTblFuel5Y" class="p-2 text-red-900 font-bold">$20,854</td>
            <td id="repTblEv5Y" class="p-2 text-slate-900 font-bold">$2,544</td>
            <td id="repTblSave5Y" class="p-2 text-emerald-900 font-black text-xs">+$18,310</td>
            <td id="repTblCo25Y" class="p-2 text-emerald-950 font-bold">~10.8 Tonnes CO₂</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 6. Strategic Takeaways & Environmental Audit -->
  <div class="mb-3">
    <div class="text-[9px] font-black uppercase tracking-wider text-slate-500 mb-1.5">4. Strategic Engineering & Environmental Audit</div>
    <div class="grid grid-cols-2 gap-2 text-[10px] leading-relaxed">
      <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200 flex items-start gap-2">
        <span class="text-sm">🌿</span>
        <div>
          <strong class="text-slate-950 block font-bold mb-0.5">Air Quality & Decarbonisation Impact</strong>
          <p id="repCo2Desc" class="text-slate-600">
            Avoiding fuel combustion eliminates approximately <strong>~2.2 Tonnes of tailpipe CO₂</strong> annually, equivalent to the atmospheric carbon absorption of <strong>~103 mature trees</strong>.
          </p>
        </div>
      </div>
      <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200 flex items-start gap-2">
        <span class="text-sm">⚙️</span>
        <div>
          <strong class="text-slate-950 block font-bold mb-0.5">Powertrain Simplicity & Maintenance Delta</strong>
          <p class="text-slate-600">
            Electric motors eliminate 2,000+ moving combustion parts (motor oil, spark plugs, timing belts, exhaust). Regenerative braking extends brake pad lifespan to 100,000+ kilometers.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- 7. Official Document Verification Footer -->
  <div class="pt-2 border-t border-slate-300 flex items-center justify-between text-[9px] text-slate-500 font-medium">
    <div>
      <p><strong>VoltSavings™ Financial Engine</strong> • Model: Client-Side Algorithmic Simulation (www.evcalculator.online)</p>
      <p>Data privacy guaranteed: No user inputs were stored or transmitted to external servers.</p>
    </div>
    <div class="text-right">
      <div class="font-bold text-slate-800 uppercase tracking-wider">OFFICIAL PRINT SUMMARY</div>
      <div>Page 1 of 1</div>
    </div>
  </div>

</div>

<style>
  @media screen {
    #executiveReportPrint {
      display: none !important;
    }
  }
  @media print {
    #executiveReportPrint {
      display: block !important;
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      box-shadow: none !important;
      border: none !important;
    }
  }
</style>
