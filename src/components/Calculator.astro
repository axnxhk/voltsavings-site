  function fmt(val: number): string {
    return currentSymbol + " " + Math.round(val).toLocaleString();
  }

  // Core Calculation Function with Precise US & UK Imperial Gallon Math
  function calculate() {
    const dist = parseFloat(dailyDistance?.value) || 0;
    selectedDays = parseFloat(customDays?.value) || 26;
    const fEff = parseFloat(fuelEfficiency?.value) || 1;
    const fPrice = parseFloat(fuelPrice?.value) || 0;
    const eEff = parseFloat(evEfficiency?.value) || 1;
    const eRate = parseFloat(electricityRate?.value) || 0;
    const fMaintCost = parseFloat(fuelMaint?.value) || 0;
    const eMaintCost = parseFloat(evMaint?.value) || 0;

    const monthlyDistance = dist * selectedDays;

    let monthlyFuelCost = 0;
    let fuelCostPerUnit = 0;
    let monthlyFuelVolume = 0;

    if (activeRegion === 'GB') {
      // UK IMPERIAL GALLON MATH:
      // UK fuel is sold at pumps in £ per Litre (fPrice).
      // Car efficiency is measured in UK Imperial MPG (fEff).
      // 1 UK Imperial Gallon = 4.54609 Litres.
      // Price per Imperial Gallon = fPrice * 4.54609
      // Fuel cost per mile (£) = (fPrice * 4.54609) / fEff
      // Total monthly fuel cost (£) = (monthlyDistance / fEff) * (fPrice * 4.54609) + fMaintCost
      const pricePerImpGal = fPrice * 4.54609;
      const monthlyImpGallons = fEff > 0 ? (monthlyDistance / fEff) : 0;
      monthlyFuelVolume = monthlyImpGallons * 4.54609; // In litres for CO2
      monthlyFuelCost = (monthlyImpGallons * pricePerImpGal) + fMaintCost;
      fuelCostPerUnit = fEff > 0 ? (pricePerImpGal / fEff) : 0; // Cost per mile (£)
    } else if (activeRegion === 'US' || !isMetric) {
      // US GALLON MATH:
      // US gas is sold in $ per US Gallon (fPrice).
      // Car efficiency is measured in US MPG (fEff).
      // Monthly US Gallons = monthlyDistance / fEff
      // Fuel cost per mile ($) = fPrice / fEff
      // Total monthly fuel cost ($) = (monthlyDistance / fEff) * fPrice + fMaintCost
      const monthlyUsGallons = fEff > 0 ? (monthlyDistance / fEff) : 0;
      monthlyFuelVolume = monthlyUsGallons; // In US gallons for CO2
      monthlyFuelCost = (monthlyUsGallons * fPrice) + fMaintCost;
      fuelCostPerUnit = fEff > 0 ? (fPrice / fEff) : 0; // Cost per mile ($)
    } else {
      // METRIC (km & Litre) MATH:
      const monthlyLiters = fEff > 0 ? (monthlyDistance / fEff) : 0;
      monthlyFuelVolume = monthlyLiters;
      monthlyFuelCost = (monthlyLiters * fPrice) + fMaintCost;
      fuelCostPerUnit = fEff > 0 ? (fPrice / fEff) : 0; // Cost per km
    }

    const fuelCostYearly = monthlyFuelCost * 12;

    // EV Energy Math (Both US & UK use mi/kWh, metric uses km/kWh)
    const monthlyEvKwh = eEff > 0 ? (monthlyDistance / eEff) : 0;
    const evCostMonthly = (monthlyEvKwh * eRate) + eMaintCost;
    const evCostYearly = evCostMonthly * 12;
    const evCostPerUnit = eEff > 0 ? (eRate / eEff) : 0; // Cost per mile/km

    const annualSavings = Math.max(0, fuelCostYearly - evCostYearly);
    const monthlySavings = Math.max(0, monthlyFuelCost - evCostMonthly);
    const pctSavings = fuelCostYearly > 0 ? Math.round((annualSavings / fuelCostYearly) * 100) : 0;

    // Environmental Impact Calculation
    let annualFuelCo2 = 0;
    if (activeRegion === 'GB') {
      annualFuelCo2 = monthlyFuelVolume * 12 * 2.31; // 2.31 kg CO2/Litre
    } else if (activeRegion === 'US' || !isMetric) {
      annualFuelCo2 = monthlyFuelVolume * 12 * 8.89; // 8.89 kg CO2/US Gallon
    } else {
      annualFuelCo2 = monthlyFuelVolume * 12 * 2.31;
    }
    const annualEvCo2 = (monthlyEvKwh * 12 * 0.45); // Average grid ~0.45 kg CO2/kWh
    const annualCo2SavedKg = Math.max(0, Math.round(annualFuelCo2 - annualEvCo2));
    const treeEquivalent = Math.max(1, Math.round(annualCo2SavedKg / 21));

    // Update Distance Display
    const uUnit = (activeRegion === 'US' || activeRegion === 'GB' || !isMetric) ? 'mi' : 'km';
    if (distanceDisplay) {
      distanceDisplay.innerText = dist + " " + uUnit;
    }

    // Update Hero Results
    const annualTxt = document.getElementById('annualSavingsText');
    const monthlyTxt = document.getElementById('monthlySavingsText');
    const savingPct = document.getElementById('savingPercentage');
    const mobSavings = document.getElementById('mobileSavingsText');

    if (annualTxt) annualTxt.innerText = fmt(annualSavings);
    if (monthlyTxt) monthlyTxt.innerText = fmt(monthlySavings);
    if (mobSavings) mobSavings.innerText = fmt(annualSavings) + " / yr";
    if (savingPct) savingPct.innerText = "Save ~" + pctSavings + "%";

    // Visual Cost Comparison Gauge with Pence / Cents per Mile
    const gaugePetrolTxt = document.getElementById('gaugePetrolText');
    const gaugeEvTxt = document.getElementById('gaugeEvText');
    const gaugeNetTxt = document.getElementById('gaugeNetText');
    const gaugeEvBar = document.getElementById('gaugeEvBar');

    let fuelRateBadge = "";
    let evRateBadge = "";

    if (activeRegion === 'GB') {
      fuelRateBadge = ` (${(fuelCostPerUnit * 100).toFixed(1)}p/mi)`;
      evRateBadge = ` (${(evCostPerUnit * 100).toFixed(1)}p/mi)`;
    } else if (activeRegion === 'US' || !isMetric) {
      fuelRateBadge = ` (${(fuelCostPerUnit * 100).toFixed(1)}¢/mi)`;
      evRateBadge = ` (${(evCostPerUnit * 100).toFixed(1)}¢/mi)`;
    } else {
      fuelRateBadge = ` (${currentSymbol}${fuelCostPerUnit.toFixed(2)}/km)`;
      evRateBadge = ` (${currentSymbol}${evCostPerUnit.toFixed(2)}/km)`;
    }

    if (gaugePetrolTxt) gaugePetrolTxt.innerText = fmt(monthlyFuelCost) + " / mo" + fuelRateBadge;
    if (gaugeEvTxt) gaugeEvTxt.innerText = fmt(evCostMonthly) + " / mo" + evRateBadge;
    if (gaugeNetTxt) gaugeNetTxt.innerText = "+ " + fmt(monthlySavings) + " / mo";

    if (gaugeEvBar) {
      const evBarWidth = monthlyFuelCost > 0 ? Math.min(100, Math.max(8, (evCostMonthly / monthlyFuelCost) * 100)) : 10;
      gaugeEvBar.style.width = evBarWidth + "%";
    }

    // Update Environmental Impact
    const co2El = document.getElementById('co2SavedText');
    const treeEl = document.getElementById('treeEquivalentText');
    if (co2El) co2El.innerText = annualCo2SavedKg > 1000 ? `~${(annualCo2SavedKg / 1000).toFixed(1)} Tonnes` : `~${annualCo2SavedKg} kg`;
    if (treeEl) treeEl.innerText = `~${treeEquivalent} Trees`;

    // Update Multi-Year ROI Matrix Table
    const setEl = (id: string, text: string) => {
      const el = document.getElementById(id);
      if (el) el.innerText = text;
    };

    setEl('tblFuel1M', fmt(monthlyFuelCost));
    setEl('tblEv1M', fmt(evCostMonthly));
    setEl('tblSave1M', fmt(monthlySavings));

    setEl('tblFuel1Y', fmt(fuelCostYearly));
    setEl('tblEv1Y', fmt(evCostYearly));
    setEl('tblSave1Y', fmt(annualSavings));

    setEl('tblFuel3Y', fmt(fuelCostYearly * 3));
    setEl('tblEv3Y', fmt(evCostYearly * 3));
    setEl('tblSave3Y', fmt(annualSavings * 3));

    setEl('tblFuel5Y', fmt(fuelCostYearly * 5));
    setEl('tblEv5Y', fmt(evCostYearly * 5));
    setEl('tblSave5Y', fmt(annualSavings * 5));

    // Keep Executive Print Report In Sync
    updateExecutiveReport();
  }

  // Populate Executive Document Print Template
  function updateExecutiveReport() {
    try {
      const dist = parseFloat(dailyDistance?.value) || 0;
      selectedDays = parseFloat(customDays?.value) || 26;
      const fEff = parseFloat(fuelEfficiency?.value) || 1;
      const fPrice = parseFloat(fuelPrice?.value) || 0;
      const eEff = parseFloat(evEfficiency?.value) || 1;
      const eRate = parseFloat(electricityRate?.value) || 0;
      const fMaintCost = parseFloat(fuelMaint?.value) || 0;
      const eMaintCost = parseFloat(evMaint?.value) || 0;

      const monthlyDistance = dist * selectedDays;

      let monthlyFuelCost = 0;
      let monthlyFuelVolume = 0;
      let fuelCostPerUnit = 0;

      if (activeRegion === 'GB') {
        const pricePerImpGal = fPrice * 4.54609;
        const monthlyImpGallons = fEff > 0 ? (monthlyDistance / fEff) : 0;
        monthlyFuelVolume = monthlyImpGallons * 4.54609;
        monthlyFuelCost = (monthlyImpGallons * pricePerImpGal) + fMaintCost;
        fuelCostPerUnit = fEff > 0 ? (pricePerImpGal / fEff) : 0;
      } else if (activeRegion === 'US' || !isMetric) {
        const monthlyUsGallons = fEff > 0 ? (monthlyDistance / fEff) : 0;
        monthlyFuelVolume = monthlyUsGallons;
        monthlyFuelCost = (monthlyUsGallons * fPrice) + fMaintCost;
        fuelCostPerUnit = fEff > 0 ? (fPrice / fEff) : 0;
      } else {
        const monthlyLiters = fEff > 0 ? (monthlyDistance / fEff) : 0;
        monthlyFuelVolume = monthlyLiters;
        monthlyFuelCost = (monthlyLiters * fPrice) + fMaintCost;
        fuelCostPerUnit = fEff > 0 ? (fPrice / fEff) : 0;
      }

      const fuelCostYearly = monthlyFuelCost * 12;

      const monthlyEvKwh = eEff > 0 ? (monthlyDistance / eEff) : 0;
      const evCostMonthly = (monthlyEvKwh * eRate) + eMaintCost;
      const evCostYearly = evCostMonthly * 12;
      const evCostPerUnit = eEff > 0 ? (eRate / eEff) : 0;

      const annualSavings = Math.max(0, fuelCostYearly - evCostYearly);
      const monthlySavings = Math.max(0, monthlyFuelCost - evCostMonthly);
      const pctSavings = fuelCostYearly > 0 ? Math.round((annualSavings / fuelCostYearly) * 100) : 0;

      let annualFuelCo2 = 0;
      if (activeRegion === 'GB') {
        annualFuelCo2 = monthlyFuelVolume * 12 * 2.31;
      } else if (activeRegion === 'US' || !isMetric) {
        annualFuelCo2 = monthlyFuelVolume * 12 * 8.89;
      } else {
        annualFuelCo2 = monthlyFuelVolume * 12 * 2.31;
      }
      const annualEvCo2 = (monthlyEvKwh * 12 * 0.45);
      const annualCo2SavedKg = Math.max(0, Math.round(annualFuelCo2 - annualEvCo2));
      const treeEquivalent = Math.max(1, Math.round(annualCo2SavedKg / 21));

      const uUnit = (activeRegion === 'US' || activeRegion === 'GB' || !isMetric) ? 'mi' : 'km';
      let effUnit = "km/L";
      let vUnit = "Litre";
      let evEffUnit = "km/kWh";

      if (activeRegion === 'GB') {
        effUnit = "UK Imperial MPG";
        vUnit = "Litre (£1.45/L = £6.59/Imp Gal)";
        evEffUnit = "mi/kWh";
      } else if (activeRegion === 'US' || !isMetric) {
        effUnit = "US MPG";
        vUnit = "gal";
        evEffUnit = "mi/kWh";
      } else {
        effUnit = "km/L";
        vUnit = "L";
        evEffUnit = "km/kWh";
      }

      const setT = (id: string, text: string) => {
        const el = document.getElementById(id);
        if (el) el.innerText = text;
      };

      setT('repDate', new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }));
      setT('repCommute', `${dist} ${uUnit} / day`);
      setT('repMonthlyDist', `${monthlyDistance.toLocaleString()} ${uUnit} / mo (${selectedDays} days)`);
      setT('repPreset', `${activeRegion} Market (${activePreset.toUpperCase()})`);
      setT('repCurrency', `Currency: ${currentCurrencyCode || 'USD'} (${currentSymbol || '$'})`);
      setT('repFuelEff', `${fEff} ${effUnit}`);
      setT('repFuelPrice', `Rate: ${currentSymbol}${fPrice}/${vUnit} | Maint: ${currentSymbol}${fMaintCost}/mo`);
      setT('repEvEff', `${eEff} ${evEffUnit}`);
      setT('repPowerRate', `Rate: ${currentSymbol}${eRate}/kWh | Maint: ${currentSymbol}${eMaintCost}/mo`);

      setT('repFuelMo', fmt(monthlyFuelCost));
      setT('repFuelKm', activeRegion === 'GB' ? `${(fuelCostPerUnit * 100).toFixed(1)}p per ${uUnit}` : `${currentSymbol}${fuelCostPerUnit.toFixed(2)} per ${uUnit}`);
      setT('repEvMo', fmt(evCostMonthly));
      setT('repEvKm', activeRegion === 'GB' ? `${(evCostPerUnit * 100).toFixed(1)}p per ${uUnit}` : `${currentSymbol}${evCostPerUnit.toFixed(2)} per ${uUnit}`);
      setT('repSaveMo', `+ ${fmt(monthlySavings)}`);
      setT('repPctSave', `~${pctSavings}% COST REDUCTION`);

      setT('repTblFuel1M', fmt(monthlyFuelCost));
      setT('repTblEv1M', fmt(evCostMonthly));
      setT('repTblSave1M', `+ ${fmt(monthlySavings)}`);
      setT('repTblCo21M', `~${Math.round(annualCo2SavedKg / 12)} kg CO₂`);

      setT('repTblFuel1Y', fmt(fuelCostYearly));
      setT('repTblEv1Y', fmt(evCostYearly));
      setT('repTblSave1Y', `+ ${fmt(annualSavings)}`);
      setT('repTblCo21Y', annualCo2SavedKg > 1000 ? `~${(annualCo2SavedKg / 1000).toFixed(1)} Tonnes CO₂` : `~${annualCo2SavedKg} kg CO₂`);

      setT('repTblFuel3Y', fmt(fuelCostYearly * 3));
      setT('repTblEv3Y', fmt(evCostYearly * 3));
      setT('repTblSave3Y', `+ ${fmt(annualSavings * 3)}`);
      setT('repTblCo23Y', `~${((annualCo2SavedKg * 3) / 1000).toFixed(1)} Tonnes CO₂`);

      setT('repTblFuel5Y', fmt(fuelCostYearly * 5));
      setT('repTblEv5Y', fmt(evCostYearly * 5));
      setT('repTblSave5Y', `+ ${fmt(annualSavings * 5)}`);
      setT('repTblCo25Y', `~${((annualCo2SavedKg * 5) / 1000).toFixed(1)} Tonnes CO₂`);

      const co2Str = annualCo2SavedKg > 1000 ? `~${(annualCo2SavedKg / 1000).toFixed(1)} Tonnes` : `~${annualCo2SavedKg} kg`;
      setT('repCo2Desc', `Avoiding fuel combustion eliminates approximately ${co2Str} of tailpipe CO₂ annually, equivalent to the atmospheric carbon absorption of ~${treeEquivalent} mature trees.`);
    } catch (err) {
      console.warn('Executive report sync non-fatal error:', err);
    }
  }

  // Copy Calculation Summary with Visual Toast Feedback
  const copyBtn = document.getElementById('copyBtn');
  const copyBtnText = document.getElementById('copyBtnText');
  copyBtn?.addEventListener('click', () => {
    const annualText = document.getElementById('annualSavingsText')?.innerText || '';
    const monthlyText = document.getElementById('monthlySavingsText')?.innerText || '';
    const distText = distanceDisplay?.innerText || '';

    const text = `⚡ VoltSavings EV vs Petrol/Gas Report:
• Target Market: ${activeRegion} (${currentCurrencyCode})
• Vehicle Category: ${activePreset.toUpperCase()}
• Daily Commute: ${distText} (${customDays.value} days/month)
• Monthly Fuel Cost: ${document.getElementById('tblFuel1M')?.innerText || ''}
• Monthly EV Cost: ${document.getElementById('tblEv1M')?.innerText || ''}
• Monthly Cash Saved: ${monthlyText}
• Estimated 1-Year Savings: ${annualText}
• Estimated 5-Year Savings: ${document.getElementById('tblSave5Y')?.innerText || ''}
Calculate your exact vehicle savings free at: https://www.evcalculator.online/`;

    navigator.clipboard.writeText(text).then(() => {
      if (copyBtnText) copyBtnText.innerText = "✓ Copied to Clipboard!";
      copyBtn.classList.add('bg-emerald-600');
      copyBtn.classList.remove('bg-black');
      setTimeout(() => {
        if (copyBtnText) copyBtnText.innerText = "Copy Calculation Report";
        copyBtn.classList.remove('bg-emerald-600');
        copyBtn.classList.add('bg-black');
      }, 2500);

      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'share_calculation_summary', {
          event_category: 'engagement',
          region: activeRegion,
          country: currentCountry,
          currency: currentSymbol,
          vehicle_preset: activePreset,
          annual_savings: annualText
        });
      }
    });
  });

  // Print / Save PDF Button
  document.getElementById('printBtn')?.addEventListener('click', (e) => {
    e.preventDefault();
    try {
      updateExecutiveReport();
    } catch(err) {
      console.warn('Print sync non-fatal warning:', err);
    }
    window.print();
    if (typeof (window as any).gtag === 'function') {
      (window as any).gtag('event', 'print_savings_report', {
        region: activeRegion,
        vehicle_preset: activePreset
      });
    }
  });

  // Hide mobile floating bar when user scrolls near the breakdown table
  const breakdownSection = document.getElementById('breakdown');
  const mobileFloatingBar = document.getElementById('mobileFloatingBar');
  if (breakdownSection && mobileFloatingBar) {
    window.addEventListener('scroll', () => {
      const rect = breakdownSection.getBoundingClientRect();
      if (rect.top <= window.innerHeight && rect.bottom >= 0) {
        mobileFloatingBar.style.transform = 'translateY(120%)';
      } else {
        mobileFloatingBar.style.transform = 'translateY(0)';
      }
    }, { passive: true });
  }

  // Timezone Auto-Detection
  function autoDetectCountry(): string {
    try {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
      if (tz.includes('London')) return 'GB';
      if (tz.startsWith('America/')) return 'US';
    } catch(e) {}
    return 'US'; // Default to primary target market (US)
  }

  const detected = autoDetectCountry();
  if (detected === 'GB') {
    setRegion('GB');
  } else {
    setRegion('US');
  }

  // Fallback to IP lookup
  fetch('https://api.country.is')
    .then(res => res.json())
    .then(data => {
      if (data && data.country) {
        const code = data.country.toUpperCase();
        if (code === 'GB') {
          setRegion('GB');
        } else if (code === 'US') {
          setRegion('US');
        }
      }
    })
    .catch(() => {});
</script>
