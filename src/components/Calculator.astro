<script>
  // Country & Currency Base Configurations
  const CURRENCY_DATA = {
    'US': { code: 'USD', symbol: '$', fuelPrice: 3.50, powerRate: 0.16, isMetric: false, baseFuelMaint: 35, baseEvMaint: 10 },
    'GB': { code: 'GBP', symbol: '£', fuelPrice: 1.45, powerRate: 0.245, isMetric: false, baseFuelMaint: 28, baseEvMaint: 8 },
    'PK': { code: 'PKR', symbol: 'Rs.', fuelPrice: 280, powerRate: 40, isMetric: true, baseFuelMaint: 1500, baseEvMaint: 200 },
    'EU': { code: 'EUR', symbol: '€', fuelPrice: 1.85, powerRate: 0.32, isMetric: true, baseFuelMaint: 30, baseEvMaint: 8 },
    'IN': { code: 'INR', symbol: '₹', fuelPrice: 102, powerRate: 8, isMetric: true, baseFuelMaint: 600, baseEvMaint: 100 },
    'AE': { code: 'AED', symbol: 'AED', fuelPrice: 3.15, powerRate: 0.30, isMetric: true, baseFuelMaint: 100, baseEvMaint: 25 },
    'CA': { code: 'CAD', symbol: '$', fuelPrice: 1.65, powerRate: 0.16, isMetric: true, baseFuelMaint: 40, baseEvMaint: 12 },
    'AU': { code: 'AUD', symbol: '$', fuelPrice: 1.95, powerRate: 0.25, isMetric: true, baseFuelMaint: 45, baseEvMaint: 15 },
  };

  // Realistic vehicle presets specification
  const PRESET_SPECS = {
    bike: {
      metric: { fuelEff: 40, evEff: 30, maintMult: 1 },
      imperial: { fuelEff: 75, evEff: 18, maintMult: 1 },
      fuelHint: "Typical 70cc-125cc commuter motorcycle",
      evHint: "Electric bike / 1.5-2.5 kWh battery"
    },
    car_compact: {
      metric: { fuelEff: 15, evEff: 7.5, maintMult: 2.8 },
      imperial: { fuelEff: 35, evEff: 4.6, maintMult: 2.5 },
      fuelHint: "Hatchback / City Car (e.g. Fiesta, Swift, Leaf)",
      evHint: "Compact city EV (e.g. Chevy Bolt, MG4, Dolphin)"
    },
    car_sedan: {
      metric: { fuelEff: 11, evEff: 6.0, maintMult: 4.2 },
      imperial: { fuelEff: 28, evEff: 3.8, maintMult: 3.8 },
      fuelHint: "Sedan / Crossover (e.g. Camry, Civic, RAV4, Sportage)",
      evHint: "EV Sedan / Crossover (e.g. Ioniq 5, Equinox EV, EV6)"
    },
    car_tesla: {
      metric: { fuelEff: 10, evEff: 6.3, maintMult: 4.5 },
      imperial: { fuelEff: 26, evEff: 4.0, maintMult: 4.0 },
      fuelHint: "Performance Petrol Sedan / SUV (e.g. BMW 3, Audi Q5)",
      evHint: "Tesla Model 3 / Model Y & BYD Seal (60-75 kWh)"
    }
  };

  // State
  let activeRegion: 'US' | 'GB' | 'GLOBAL' = 'US';
  let isMetric = false;
  let selectedDays = 26;
  let currentCountry = 'US';
  let currentSymbol = '$';
  let currentCurrencyCode = 'USD';
  let activePreset = 'car_tesla';

  // Elements
  const dailyDistance = document.getElementById('dailyDistance') as HTMLInputElement;
  const distanceDisplay = document.getElementById('distanceDisplay');
  const distMin = document.getElementById('distMin');
  const distMax = document.getElementById('distMax');
  const fuelEfficiency = document.getElementById('fuelEfficiency') as HTMLInputElement;
  const fuelPrice = document.getElementById('fuelPrice') as HTMLInputElement;
  const evEfficiency = document.getElementById('evEfficiency') as HTMLInputElement;
  const electricityRate = document.getElementById('electricityRate') as HTMLInputElement;
  const fuelMaint = document.getElementById('fuelMaint') as HTMLInputElement;
  const evMaint = document.getElementById('evMaint') as HTMLInputElement;
  const currencySelect = document.getElementById('currencySelect') as HTMLSelectElement;
  const resetDefaultsBtn = document.getElementById('resetDefaultsBtn');
  const unitMetric = document.getElementById('unitMetric');
  const unitImperial = document.getElementById('unitImperial');
  const customDays = document.getElementById('customDays') as HTMLInputElement;
  const txtFuelHint = document.getElementById('txtFuelHint');
  const txtEvHint = document.getElementById('txtEvHint');
  const btnRegionUS = document.getElementById('btnRegionUS');
  const btnRegionUK = document.getElementById('btnRegionUK');
  const btnRegionGlobal = document.getElementById('btnRegionGlobal');
  const activeRegionBadge = document.getElementById('activeRegionBadge');
  const lblFuelEfficiency = document.getElementById('lblFuelEfficiency');
  const lblFuelPrice = document.getElementById('lblFuelPrice');
  const lblEvEfficiency = document.getElementById('lblEvEfficiency');
  const txtFuelPriceHint = document.getElementById('txtFuelPriceHint');
  const txtElectricityHint = document.getElementById('txtElectricityHint');
  const lblEvModelSelect = document.getElementById('lblEvModelSelect');
  const lblElectricityChips = document.getElementById('lblElectricityChips');
  const evModelPresetSelect = document.getElementById('evModelPresetSelect') as HTMLSelectElement;
  const electricityChipsContainer = document.getElementById('electricityChipsContainer');

  // Update Currency Symbols throughout DOM
  function updateCurrencySymbols(sym: string) {
    document.querySelectorAll('.currency-symbol').forEach(el => {
      (el as HTMLElement).innerText = sym;
    });
  }

  // Update Unit Selector Buttons Visually
  function updateUnitButtons(metricMode: boolean) {
    isMetric = metricMode;
    if (metricMode) {
      if (unitMetric) unitMetric.className = "px-4 py-2.5 sm:py-1.5 rounded-lg text-center bg-emerald-600 text-white transition-all shadow-sm min-h-[44px] sm:min-h-0 flex items-center justify-center cursor-pointer";
      if (unitImperial) unitImperial.className = "px-4 py-2.5 sm:py-1.5 rounded-lg text-center text-gray-700 hover:text-black transition-all min-h-[44px] sm:min-h-0 flex items-center justify-center cursor-pointer";
      if (distMin) distMin.innerText = "5 km/day";
      if (distMax) distMax.innerText = "250 km/day";
      if (dailyDistance) dailyDistance.max = "250";
    } else {
      if (unitImperial) unitImperial.className = "px-4 py-2.5 sm:py-1.5 rounded-lg text-center bg-emerald-600 text-white transition-all shadow-sm min-h-[44px] sm:min-h-0 flex items-center justify-center cursor-pointer";
      if (unitMetric) unitMetric.className = "px-4 py-2.5 sm:py-1.5 rounded-lg text-center text-gray-700 hover:text-black transition-all min-h-[44px] sm:min-h-0 flex items-center justify-center cursor-pointer";
      if (distMin) distMin.innerText = "5 mi/day";
      if (distMax) distMax.innerText = "150 mi/day";
      if (dailyDistance) dailyDistance.max = "150";
    }
  }

  // Populate Popular EV Models Preset Dropdown
  function populateEvModels(reg: 'US' | 'GB' | 'GLOBAL') {
    if (!evModelPresetSelect) return;
    evModelPresetSelect.innerHTML = '';

    let models: Array<{ id: string; name: string; evEff: number; fuelEff: number; fMaint: number; evMaint: number; hint: string }> = [];

    if (reg === 'US') {
      models = [
        { id: '', name: '⚡ Select US EV Model Preset...', evEff: 0, fuelEff: 0, fMaint: 35, evMaint: 10, hint: '' },
        { id: 'us-tesla-y', name: 'Tesla Model Y (3.8 mi/kWh | 28 US MPG)', evEff: 3.8, fuelEff: 28, fMaint: 35, evMaint: 10, hint: 'Tesla Model Y Long Range (3.8 mi/kWh vs 28 US MPG SUV)' },
        { id: 'us-tesla-3', name: 'Tesla Model 3 (4.1 mi/kWh | 32 US MPG)', evEff: 4.1, fuelEff: 32, fMaint: 35, evMaint: 10, hint: 'Tesla Model 3 Highland (4.1 mi/kWh vs 32 US MPG Sedan)' },
        { id: 'us-f150', name: 'Ford F-150 Lightning (2.1 mi/kWh | 18 US MPG)', evEff: 2.1, fuelEff: 18, fMaint: 45, evMaint: 15, hint: 'Ford F-150 Lightning EV Truck (2.1 mi/kWh vs 18 US MPG V8)' },
        { id: 'us-equinox', name: 'Chevy Equinox EV (3.4 mi/kWh | 27 US MPG)', evEff: 3.4, fuelEff: 27, fMaint: 35, evMaint: 10, hint: 'Chevy Equinox EV (3.4 mi/kWh vs 27 US MPG Crossover)' },
        { id: 'us-ioniq5', name: 'Hyundai Ioniq 5 (3.5 mi/kWh | 29 US MPG)', evEff: 3.5, fuelEff: 29, fMaint: 35, evMaint: 10, hint: 'Hyundai Ioniq 5 (3.5 mi/kWh vs 29 US MPG Crossover)' }
      ];
    } else if (reg === 'GB') {
      models = [
        { id: '', name: '⚡ Select UK EV Model Preset...', evEff: 0, fuelEff: 0, fMaint: 28, evMaint: 8, hint: '' },
        { id: 'uk-tesla-y', name: 'Tesla Model Y (3.8 mi/kWh | 36 UK MPG)', evEff: 3.8, fuelEff: 36, fMaint: 28, evMaint: 8, hint: 'Tesla Model Y (3.8 mi/kWh vs 36 UK Imperial MPG SUV)' },
        { id: 'uk-mg4', name: 'MG4 EV (3.9 mi/kWh | 44 UK MPG)', evEff: 3.9, fuelEff: 44, fMaint: 25, evMaint: 7, hint: 'MG4 EV Hatchback (3.9 mi/kWh vs 44 UK Imperial MPG)' },
        { id: 'uk-leaf', name: 'Nissan Leaf (3.7 mi/kWh | 42 UK MPG)', evEff: 3.7, fuelEff: 42, fMaint: 25, evMaint: 7, hint: 'Nissan Leaf (3.7 mi/kWh vs 42 UK Imperial MPG)' },
        { id: 'uk-id3', name: 'Volkswagen ID.3 (3.8 mi/kWh | 45 UK MPG)', evEff: 3.8, fuelEff: 45, fMaint: 28, evMaint: 8, hint: 'Volkswagen ID.3 (3.8 mi/kWh vs 45 UK Imperial MPG Golf)' },
        { id: 'uk-corsa', name: 'Vauxhall Corsa Electric (4.0 mi/kWh | 48 UK MPG)', evEff: 4.0, fuelEff: 48, fMaint: 24, evMaint: 7, hint: 'Vauxhall Corsa Electric (4.0 mi/kWh vs 48 UK Imperial MPG)' }
      ];
    } else {
      models = [
        { id: '', name: '⚡ Select Calibrated EV Model...', evEff: 0, fuelEff: 0, fMaint: 1000, evMaint: 200, hint: '' },
        { id: 'gl-tesla-y', name: 'Tesla Model Y / Model 3', evEff: isMetric ? 6.3 : 3.8, fuelEff: isMetric ? 10 : 28, fMaint: 1500, evMaint: 200, hint: 'Tesla Model Y / 3 Calibration' },
        { id: 'gl-byd', name: 'BYD Atto 3 / Seal', evEff: isMetric ? 6.1 : 3.7, fuelEff: isMetric ? 11 : 29, fMaint: 1500, evMaint: 200, hint: 'BYD Blade Battery Calibration' },
        { id: 'gl-mg4', name: 'MG4 Electric / ZS EV', evEff: isMetric ? 6.2 : 3.8, fuelEff: isMetric ? 12 : 32, fMaint: 1400, evMaint: 180, hint: 'MG Electric Calibration' }
      ];
    }

    models.forEach(m => {
      const opt = document.createElement('option');
      opt.value = m.id;
      opt.textContent = m.name;
      evModelPresetSelect.appendChild(opt);
    });

    evModelPresetSelect.onchange = () => {
      const found = models.find(m => m.id === evModelPresetSelect.value);
      if (found && found.evEff > 0) {
        evEfficiency.value = String(found.evEff);
        fuelEfficiency.value = String(found.fuelEff);
        fuelMaint.value = String(found.fMaint);
        evMaint.value = String(found.evMaint);
        if (txtFuelHint) txtFuelHint.innerText = found.hint;
        if (txtEvHint) txtEvHint.innerText = found.name;

        // Unhighlight category buttons to show customized model
        document.querySelectorAll('.preset-btn').forEach(btn => {
          btn.classList.remove('border-emerald-600', 'bg-emerald-50/70', 'shadow-sm');
          btn.classList.add('border-gray-200', 'bg-white');
          btn.setAttribute('aria-checked', 'false');
          const badge = btn.querySelector('.preset-badge');
          if (badge) {
            badge.className = 'preset-badge text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-md bg-gray-100 text-gray-600';
            badge.textContent = 'Select';
          }
        });
        calculate();
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'select_ev_model_preset', { model: found.id, region: activeRegion });
        }
      }
    };
  }

  // Render Dynamic Electricity Chips
  function renderElectricityChips(reg: 'US' | 'GB' | 'GLOBAL') {
    if (!electricityChipsContainer) return;
    electricityChipsContainer.innerHTML = '';

    let list: Array<{ label: string; rate: number }> = [];

    if (reg === 'US') {
      list = [
        { label: 'US Avg ($0.16/kWh)', rate: 0.16 },
        { label: 'Off-Peak Night ($0.08/kWh)', rate: 0.08 },
        { label: 'California PG&E ($0.34/kWh)', rate: 0.34 },
        { label: 'DC Fast Charger ($0.48/kWh)', rate: 0.48 }
      ];
    } else if (reg === 'GB') {
      list = [
        { label: 'Ofgem Price Cap (24.5p/kWh)', rate: 0.245 },
        { label: 'Octopus Intelligent Go (7p/kWh)', rate: 0.07 },
        { label: 'Public Rapid Charger (79p/kWh)', rate: 0.79 }
      ];
    } else {
      const cData = CURRENCY_DATA[currentCountry as keyof typeof CURRENCY_DATA] || CURRENCY_DATA['PK'];
      list = [
        { label: `Grid Tariff (${currentSymbol}${cData.powerRate}/kWh)`, rate: cData.powerRate },
        { label: `Off-Peak (${currentSymbol}${(cData.powerRate * 0.55).toFixed(2)}/kWh)`, rate: Number((cData.powerRate * 0.55).toFixed(2)) },
        { label: `Fast Charger (${currentSymbol}${(cData.powerRate * 1.8).toFixed(2)}/kWh)`, rate: Number((cData.powerRate * 1.8).toFixed(2)) }
      ];
    }

    const currentVal = parseFloat(electricityRate?.value);

    list.forEach(item => {
      const chip = document.createElement('button');
      chip.type = 'button';
      const isSelected = Math.abs(currentVal - item.rate) < 0.001;
      chip.className = isSelected
        ? 'elec-chip px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-600 text-white cursor-pointer transition-all shadow-xs'
        : 'elec-chip px-2.5 py-1 rounded-lg text-xs font-bold bg-white border border-gray-200 hover:border-emerald-500 text-gray-700 hover:text-emerald-700 cursor-pointer transition-all';
      chip.innerText = item.label;

      chip.addEventListener('click', () => {
        electricityRate.value = String(item.rate);
        document.querySelectorAll('.elec-chip').forEach(c => {
          c.className = 'elec-chip px-2.5 py-1 rounded-lg text-xs font-bold bg-white border border-gray-200 hover:border-emerald-500 text-gray-700 hover:text-emerald-700 cursor-pointer transition-all';
        });
        chip.className = 'elec-chip px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-600 text-white cursor-pointer transition-all shadow-xs';
        calculate();
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', 'select_tariff_preset', { tariff: item.label, rate: item.rate, region: activeRegion });
        }
      });

      electricityChipsContainer.appendChild(chip);
    });
  }

