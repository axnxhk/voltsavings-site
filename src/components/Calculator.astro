  // Apply Vehicle Preset Category
  function applyPreset(presetKey: string) {
    activePreset = presetKey;

    document.querySelectorAll('.preset-btn').forEach(btn => {
      const p = btn.getAttribute('data-preset');
      const badge = btn.querySelector('.preset-badge');
      if (p === presetKey) {
        btn.classList.add('border-emerald-600', 'bg-emerald-50/70', 'shadow-sm');
        btn.classList.remove('border-gray-200', 'bg-white');
        btn.setAttribute('aria-checked', 'true');
        if (badge) {
          badge.className = 'preset-badge text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-md bg-emerald-600 text-white';
          badge.textContent = 'Selected';
        }
      } else {
        btn.classList.remove('border-emerald-600', 'bg-emerald-50/70', 'shadow-sm');
        btn.classList.add('border-gray-200', 'bg-white');
        btn.setAttribute('aria-checked', 'false');
        if (badge) {
          badge.className = 'preset-badge text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-md bg-gray-100 text-gray-600';
          badge.textContent = p === 'custom' ? 'Custom' : 'Select';
        }
      }
    });

    if (presetKey === 'custom') {
      if (txtFuelHint) txtFuelHint.innerText = "Custom user-defined fuel rating";
      if (txtEvHint) txtEvHint.innerText = "Custom user-defined EV rating";
      calculate();
      return;
    }

    const spec = PRESET_SPECS[presetKey as keyof typeof PRESET_SPECS];
    if (!spec) return;

    const unitSpec = isMetric ? spec.metric : spec.imperial;
    
    // Scale UK Imperial MPG realistically (UK gallons are ~20% larger than US gallons)
    if (activeRegion === 'GB' && !isMetric) {
      // 1 UK Imperial Gallon = 1.20095 US Gallons
      fuelEfficiency.value = String(Math.round(unitSpec.fuelEff * 1.2));
    } else {
      fuelEfficiency.value = String(unitSpec.fuelEff);
    }
    
    evEfficiency.value = String(unitSpec.evEff);

    const countryData = CURRENCY_DATA[currentCountry as keyof typeof CURRENCY_DATA] || CURRENCY_DATA['US'];
    fuelMaint.value = String(Math.round(countryData.baseFuelMaint * unitSpec.maintMult));
    evMaint.value = String(Math.round(countryData.baseEvMaint * unitSpec.maintMult));

    if (txtFuelHint) txtFuelHint.innerText = spec.fuelHint;
    if (txtEvHint) txtEvHint.innerText = spec.evHint;

    calculate();
  }

