---
---

<div id="calculator-app" class="scroll-mt-20">
  
  <!-- Floating Mobile Summary Pill (Shows on mobile when adjusting inputs) -->
  <div id="mobileFloatingBar" class="fixed bottom-4 left-4 right-4 z-40 sm:hidden bg-gray-900/95 backdrop-blur-md text-white p-3.5 rounded-2xl shadow-2xl border border-gray-700/60 flex items-center justify-between transition-all duration-300 transform translate-y-0">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-sm font-black">
        ⚡
      </div>
      <div>
        <p class="text-[10px] text-gray-400 font-bold uppercase tracking-wider">Est. Annual Savings</p>
        <p id="mobileSavingsText" class="text-base font-black text-emerald-400 leading-tight">Rs. 0</p>
      </div>
    </div>
    <a href="#breakdown" class="px-3.5 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-all flex items-center gap-1 shadow-sm">
      Breakdown ↓
    </a>
  </div>

  <!-- Region Switcher: US vs UK Market Calibration -->
  <div class="bg-gradient-to-r from-gray-950 via-slate-900 to-gray-900 text-white rounded-2xl sm:rounded-3xl p-3.5 sm:p-5 mb-5 shadow-lg border border-gray-800">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-3 sm:gap-4">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-base font-black shrink-0">
          <i class="fa-solid fa-earth-americas"></i>
        </div>
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-xs sm:text-sm font-black text-white">Target Market / Region:</span>
            <span id="activeRegionBadge" class="text-[10px] font-bold text-emerald-300 bg-emerald-950/80 border border-emerald-500/40 px-2 py-0.5 rounded-full">🇺🇸 US Mode ($ / Miles)</span>
          </div>
          <p class="text-[11px] text-gray-300 font-medium mt-0.5">Auto-calibrates gas/petrol price, Imperial vs US Gallon math, tariffs & models</p>
        </div>
      </div>

      <!-- Region Switcher 3-Way Buttons -->
      <div class="grid grid-cols-3 gap-1.5 bg-gray-900/90 p-1.5 rounded-xl border border-gray-700/80 w-full md:w-auto" id="regionToggleGroup" role="group" aria-label="Region Selector">
        <button type="button" id="btnRegionUS" class="region-toggle-btn px-3 py-2 rounded-lg text-xs font-black transition-all flex items-center justify-center gap-1.5 cursor-pointer bg-emerald-600 text-white shadow-xs">
          <span>🇺🇸</span> <span>US ($ / Miles)</span>
        </button>
        <button type="button" id="btnRegionUK" class="region-toggle-btn px-3 py-2 rounded-lg text-xs font-black transition-all flex items-center justify-center gap-1.5 cursor-pointer text-gray-300 hover:text-white hover:bg-gray-800">
          <span>🇬🇧</span> <span>UK (£ / Miles)</span>
        </button>
        <button type="button" id="btnRegionGlobal" class="region-toggle-btn px-3 py-2 rounded-lg text-xs font-black transition-all flex items-center justify-center gap-1.5 cursor-pointer text-gray-300 hover:text-white hover:bg-gray-800">
          <span>🌍</span> <span>Global / Other</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Controls Bar (Currency & Unit) -->
  <div class="bg-white border border-gray-200/90 rounded-2xl sm:rounded-3xl p-3.5 sm:p-5 mb-8 shadow-sm overflow-hidden">
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 sm:gap-4">
      
      <!-- Currency / Country Selector -->
      <div class="flex flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-3 w-full sm:w-auto">
        <label for="currencySelect" class="text-xs font-black uppercase tracking-wider text-gray-700 flex items-center gap-1.5">
          <i class="fa-solid fa-earth-americas text-emerald-600"></i> Country & Currency:
        </label>
        <select id="currencySelect" class="w-full sm:w-auto bg-gray-50 hover:bg-gray-100/80 border border-gray-300 text-sm sm:text-xs font-bold rounded-xl px-3 py-2 text-black focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 cursor-pointer min-h-[44px] transition-all">
          <option value="PK">🇵🇰 Pakistan (PKR - Rs.)</option>
          <option value="US">🇺🇸 United States (USD - $)</option>
          <option value="EU">🇪🇺 Europe (EUR - €)</option>
          <option value="GB">🇬🇧 United Kingdom (GBP - £)</option>
          <option value="IN">🇮🇳 India (INR - ₹)</option>
          <option value="AE">🇦🇪 United Arab Emirates (AED)</option>
          <option value="CA">🇨🇦 Canada (CAD - $)</option>
          <option value="AU">🇦🇺 Australia (AUD - $)</option>
        </select>
      </div>

      <!-- Distance Unit Selector -->
      <div class="flex flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-3 w-full sm:w-auto">
        <span class="text-xs font-black uppercase tracking-wider text-gray-700 flex items-center gap-1.5">
          <i class="fa-solid fa-ruler-horizontal text-emerald-600"></i> Measurement:
        </span>
        <div class="grid grid-cols-2 bg-gray-100 p-1 rounded-xl border border-gray-200 text-xs font-bold w-full sm:w-auto" role="group" aria-label="Distance Unit Selector">
          <button type="button" id="unitMetric" class="px-2.5 py-2 sm:px-4 sm:py-1.5 rounded-lg text-center bg-emerald-600 text-white transition-all shadow-sm min-h-[42px] sm:min-h-0 flex items-center justify-center cursor-pointer text-xs">Metric (km/L)</button>
          <button type="button" id="unitImperial" class="px-2.5 py-2 sm:px-4 sm:py-1.5 rounded-lg text-center text-gray-700 hover:text-black transition-all min-h-[42px] sm:min-h-0 flex items-center justify-center cursor-pointer text-xs">Imperial (mi/gal)</button>
        </div>
      </div>

    </div>
  </div>

  <!-- Vehicle Presets Cards (Key UX Feature!) -->
  <div class="mb-8">
    <div class="flex items-center justify-between mb-3">
      <div>
        <h2 class="text-sm sm:text-base font-black text-black flex items-center gap-2">
          <span>1. Select Vehicle Category</span>
          <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full">Instant 1-Click Setup</span>
        </h2>
        <p class="text-xs text-gray-500 font-medium">Choose your ride to auto-fill realistic fuel economy & efficiency numbers</p>
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2.5 sm:gap-3" id="presetContainer" role="radiogroup" aria-label="Vehicle Presets">
      
      <!-- Preset 1: Bike / Scooter -->
      <button type="button" data-preset="bike" class="preset-btn active text-left p-3 sm:p-3.5 rounded-2xl border-2 border-emerald-600 bg-emerald-50/70 shadow-sm transition-all duration-200 cursor-pointer hover:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-500" aria-checked="true" role="radio">
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-xl sm:text-2xl">🛵</span>
          <span class="preset-badge text-[9px] font-black uppercase tracking-wider px-1.5 py-0.5 rounded-md bg-emerald-600 text-white">Selected</span>
        </div>
        <p class="font-black text-xs sm:text-sm text-black leading-tight">E-Bike / Scooter</p>
        <p class="text-[10px] text-gray-600 mt-0.5 font-medium">70cc vs EV Bike</p>
        <div class="mt-2 text-[9px] font-bold text-emerald-700 bg-white/80 rounded-lg px-1.5 py-0.5 inline-block border border-emerald-200">
          Save ~90%
        </div>
      </button>

      <!-- Preset 2: Compact / Hatchback -->
      <button type="button" data-preset="car_compact" class="preset-btn text-left p-3 sm:p-3.5 rounded-2xl border-2 border-gray-200 bg-white hover:border-gray-300 transition-all duration-200 cursor-pointer focus:outline-none focus:ring-2 focus:ring-emerald-500" aria-checked="false" role="radio">
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-xl sm:text-2xl">🚗</span>
          <span class="preset-badge text-[9px] font-black uppercase tracking-wider px-1.5 py-0.5 rounded-md bg-gray-100 text-gray-600">Select</span>
        </div>
        <p class="font-black text-xs sm:text-sm text-black leading-tight">City Hatchback</p>
        <p class="text-[10px] text-gray-600 mt-0.5 font-medium">Alto / Swift vs EV</p>
        <div class="mt-2 text-[9px] font-bold text-emerald-700 bg-emerald-50 rounded-lg px-1.5 py-0.5 inline-block border border-emerald-100">
          Save ~80%
        </div>
      </button>

      <!-- Preset 3: Sedan / Crossover -->
      <button type="button" data-preset="car_sedan" class="preset-btn text-left p-3 sm:p-3.5 rounded-2xl border-2 border-gray-200 bg-white hover:border-gray-300 transition-all duration-200 cursor-pointer focus:outline-none focus:ring-2 focus:ring-emerald-500" aria-checked="false" role="radio">
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-xl sm:text-2xl">🚙</span>
          <span class="preset-badge text-[9px] font-black uppercase tracking-wider px-1.5 py-0.5 rounded-md bg-gray-100 text-gray-600">Select</span>
        </div>
        <p class="font-black text-xs sm:text-sm text-black leading-tight">Family Sedan</p>
        <p class="text-[10px] text-gray-600 mt-0.5 font-medium">Civic / MG4 vs EV</p>
        <div class="mt-2 text-[9px] font-bold text-emerald-700 bg-emerald-50 rounded-lg px-1.5 py-0.5 inline-block border border-emerald-100">
          Save ~75%
        </div>
      </button>

      <!-- Preset 4: Tesla / BYD EV Models -->
      <button type="button" data-preset="car_tesla" class="preset-btn text-left p-3 sm:p-3.5 rounded-2xl border-2 border-gray-200 bg-white hover:border-gray-300 transition-all duration-200 cursor-pointer focus:outline-none focus:ring-2 focus:ring-emerald-500" aria-checked="false" role="radio">
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-xl sm:text-2xl">⚡</span>
          <span class="preset-badge text-[9px] font-black uppercase tracking-wider px-1.5 py-0.5 rounded-md bg-gray-100 text-gray-600">Select</span>
        </div>
        <p class="font-black text-xs sm:text-sm text-black leading-tight">Tesla / BYD EV</p>
        <p class="text-[10px] text-gray-600 mt-0.5 font-medium">Model 3/Y & Atto 3</p>
        <div class="mt-2 text-[9px] font-bold text-emerald-700 bg-emerald-50 rounded-lg px-1.5 py-0.5 inline-block border border-emerald-100">
          Save ~76%
        </div>
      </button>

      <!-- Preset 5: Custom -->
      <button type="button" data-preset="custom" class="preset-btn text-left p-3 sm:p-3.5 rounded-2xl border-2 border-gray-200 bg-white hover:border-gray-300 transition-all duration-200 cursor-pointer focus:outline-none focus:ring-2 focus:ring-emerald-500 col-span-2 sm:col-span-1" aria-checked="false" role="radio">
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-xl sm:text-2xl">⚙️</span>
          <span class="preset-badge text-[9px] font-black uppercase tracking-wider px-1.5 py-0.5 rounded-md bg-gray-100 text-gray-600">Custom</span>
        </div>
        <p class="font-black text-xs sm:text-sm text-black leading-tight">Custom</p>
        <p class="text-[10px] text-gray-600 mt-0.5 font-medium">Manual Tuning</p>
        <div class="mt-2 text-[9px] font-bold text-gray-600 bg-gray-100 rounded-lg px-1.5 py-0.5 inline-block">
          Tailored
        </div>
      </button>

    </div>

    <!-- Quick Benchmark Model Tags (Natural SEO & Real Commuter Telemetry) -->
    <div class="mt-3 pt-2.5 border-t border-gray-100 flex flex-wrap items-center gap-1.5 text-[11px] text-gray-500 font-medium">
      <span class="font-black text-gray-800 flex items-center gap-1"><i class="fa-solid fa-car-side text-emerald-600"></i> Calibrated EV Models:</span>
      <span class="px-2 py-0.5 rounded-md bg-gray-100 text-gray-700 font-bold">Tesla Model 3 / Y</span>
      <span class="px-2 py-0.5 rounded-md bg-gray-100 text-gray-700 font-bold">Ford F-150 Lightning</span>
      <span class="px-2 py-0.5 rounded-md bg-gray-100 text-gray-700 font-bold">Chevy Equinox EV</span>
      <span class="px-2 py-0.5 rounded-md bg-gray-100 text-gray-700 font-bold">Hyundai Ioniq 5</span>
      <span class="px-2 py-0.5 rounded-md bg-gray-100 text-gray-700 font-bold">MG4 Electric</span>
      <span class="px-2 py-0.5 rounded-md bg-gray-100 text-gray-700 font-bold">Nissan Leaf</span>
      <span class="px-2 py-0.5 rounded-md bg-gray-100 text-gray-700 font-bold">VW ID.3</span>
    </div>

    <!-- Dedicated Popular EV Models Dropdown -->
    <div class="mt-3.5 p-3 sm:p-4 bg-gradient-to-r from-gray-50 via-emerald-50/40 to-gray-50 border-2 border-emerald-200/80 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-xl bg-emerald-600 text-white flex items-center justify-center text-xs font-black shadow-xs shrink-0">
          <i class="fa-solid fa-car-battery"></i>
        </div>
        <div>
          <label for="evModelPresetSelect" id="lblEvModelSelect" class="text-xs sm:text-sm font-black text-gray-900 block">Popular US EV Models Dropdown:</label>
          <span class="text-[11px] text-gray-600 font-medium">Select a calibrated vehicle to auto-populate efficiency & comparison specs</span>
        </div>
      </div>
      <div class="w-full sm:w-auto">
        <select id="evModelPresetSelect" class="w-full sm:w-64 bg-white border-2 border-emerald-400 hover:border-emerald-600 text-xs font-bold rounded-xl px-3 py-2 text-black focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer min-h-[42px] transition-all shadow-xs">
          <!-- Populated dynamically based on region -->
        </select>
      </div>
    </div>
  </div>

  <!-- Main Calculator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-start">
    
    <!-- Left Column: User Inputs -->
    <div class="lg:col-span-6 bg-white border border-gray-200 rounded-3xl p-5 sm:p-7 shadow-sm">
      
      <div class="flex items-center justify-between pb-4 border-b border-gray-100 mb-6">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-emerald-100 flex items-center justify-center text-emerald-700 text-base">
            <i class="fa-solid fa-route"></i>
          </div>
          <div>
            <h2 class="text-base sm:text-lg font-black text-black">2. Your Driving Routine</h2>
            <p class="text-[11px] sm:text-xs text-gray-500 font-medium">Adjust commute distance & travel days</p>
          </div>
        </div>
        <button type="button" id="resetDefaultsBtn" class="text-xs font-bold text-gray-500 hover:text-emerald-700 flex items-center gap-1.5 transition-colors p-2 rounded-xl hover:bg-gray-100 cursor-pointer">
          <i class="fa-solid fa-rotate-left"></i> Reset
        </button>
      </div>

      <!-- Daily Distance Slider & Quick Chips -->
      <div class="mb-6 bg-gradient-to-br from-gray-50 to-emerald-50/20 p-4 sm:p-5 rounded-2xl border border-gray-200">
        <div class="flex justify-between items-center mb-3 gap-2">
          <div>
            <label for="dailyDistance" class="text-sm font-black text-black">Daily Commute Distance</label>
            <p class="text-xs text-gray-500 font-medium">Round-trip travel every day</p>
          </div>
          <span id="distanceDisplay" class="text-lg font-black text-white bg-emerald-600 px-3.5 py-1 rounded-xl shadow-md shadow-emerald-600/20 flex-shrink-0 transition-transform">35 km</span>
        </div>
        
        <input type="range" id="dailyDistance" min="5" max="250" value="35" class="w-full cursor-pointer my-2">
        
        <div class="flex justify-between text-xs text-gray-500 font-bold mb-3">
          <span id="distMin">5 km/day</span>
          <span id="distMax">250 km/day</span>
        </div>

        <!-- Quick Pick Chips for Distance -->
        <div class="pt-2 border-t border-gray-200/80 flex flex-wrap items-center gap-2">
          <span class="text-[10px] font-black uppercase text-gray-400 mr-1">Quick pick:</span>
          <button type="button" data-dist="15" class="dist-chip px-2.5 py-1 rounded-lg text-xs font-bold bg-white border border-gray-200 hover:border-emerald-500 text-gray-700 hover:text-emerald-700 cursor-pointer transition-all">15 km</button>
          <button type="button" data-dist="35" class="dist-chip px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-50 border border-emerald-300 text-emerald-800 cursor-pointer transition-all">35 km (Avg)</button>
          <button type="button" data-dist="60" class="dist-chip px-2.5 py-1 rounded-lg text-xs font-bold bg-white border border-gray-200 hover:border-emerald-500 text-gray-700 hover:text-emerald-700 cursor-pointer transition-all">60 km</button>
          <button type="button" data-dist="100" class="dist-chip px-2.5 py-1 rounded-lg text-xs font-bold bg-white border border-gray-200 hover:border-emerald-500 text-gray-700 hover:text-emerald-700 cursor-pointer transition-all">100 km (Comm)</button>
        </div>
      </div>

      <!-- Monthly Usage Days & Quick Chips -->
      <div class="mb-6 bg-gray-50 p-4 sm:p-5 rounded-2xl border border-gray-200">
        <div class="flex justify-between items-center mb-2">
          <label for="customDays" class="text-xs font-black uppercase tracking-wider text-black">Monthly Driving Days</label>
          <span class="text-xs text-gray-500 font-medium">Standard is 26 days</span>
        </div>
        <div class="relative mb-3">
          <input type="number" id="customDays" value="26" min="1" max="31" class="w-full bg-white border-2 border-gray-200 rounded-xl px-4 py-2.5 text-base sm:text-sm text-black focus:outline-none focus:border-emerald-600 font-black min-h-[44px]">
          <span class="absolute right-4 top-3 text-xs text-gray-500 font-bold pointer-events-none">Days / Month (1-31)</span>
        </div>
        <!-- Days Quick Chips -->
        <div class="flex flex-wrap items-center gap-2">
          <button type="button" data-days="22" class="days-chip px-2.5 py-1 rounded-lg text-xs font-bold bg-white border border-gray-200 hover:border-emerald-500 text-gray-700 hover:text-emerald-700 cursor-pointer transition-all">22 Days (5-Day Wk)</button>
          <button type="button" data-days="26" class="days-chip px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-50 border border-emerald-300 text-emerald-800 cursor-pointer transition-all">26 Days (Standard)</button>
          <button type="button" data-days="30" class="days-chip px-2.5 py-1 rounded-lg text-xs font-bold bg-white border border-gray-200 hover:border-emerald-500 text-gray-700 hover:text-emerald-700 cursor-pointer transition-all">30 Days (Daily)</button>
        </div>
      </div>
      
      <!-- Side by Side Vehicle Fuel & Power Specs -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        
        <!-- Petrol Vehicle Block -->
        <div class="bg-amber-50/60 border-2 border-amber-200 p-4 sm:p-5 rounded-2xl relative shadow-sm">
          <div class="flex items-center justify-between mb-4">
            <span class="flex items-center gap-2 text-amber-900 text-xs sm:text-sm font-black">
              <i class="fa-solid fa-gas-pump text-amber-600 text-base"></i> Petrol Vehicle
            </span>
            <span class="text-[10px] font-bold uppercase bg-amber-100 text-amber-800 px-2 py-0.5 rounded-md">Combustion</span>
          </div>
          
          <div class="mb-4">
            <div class="flex items-center justify-between mb-1">
              <label id="lblFuelEfficiency" for="fuelEfficiency" class="text-xs text-black font-black">Fuel Economy (km/L)</label>
            </div>
            <input type="number" id="fuelEfficiency" value="40" step="0.5" class="w-full bg-white border-2 border-amber-200 rounded-xl px-3 py-2 text-base sm:text-sm text-black focus:outline-none focus:border-amber-600 font-black min-h-[44px]">
            <p id="txtFuelHint" class="text-[11px] text-gray-600 mt-1 font-medium">Standard for selected vehicle</p>
          </div>

          <div class="mb-4">
            <label id="lblFuelPrice" for="fuelPrice" class="block text-xs text-black font-black mb-1">Fuel Price (per Liter)</label>
            <div class="relative">
              <span class="currency-symbol absolute left-3 top-2.5 text-xs text-gray-500 font-black pointer-events-none">Rs.</span>
              <input type="number" id="fuelPrice" value="280" step="0.01" class="w-full bg-white border-2 border-amber-200 rounded-xl pl-9 pr-3 py-2 text-base sm:text-sm text-black focus:outline-none focus:border-amber-600 font-black min-h-[44px]">
            </div>
            <p id="txtFuelPriceHint" class="text-[11px] text-gray-600 mt-1 font-medium">Standard fuel pump price</p>
          </div>

          <div>
            <label for="fuelMaint" class="block text-xs text-black font-black mb-1">Monthly Maintenance / Oil</label>
            <div class="relative">
              <span class="currency-symbol absolute left-3 top-2.5 text-xs text-gray-500 font-black pointer-events-none">Rs.</span>
              <input type="number" id="fuelMaint" value="1500" step="1" class="w-full bg-white border-2 border-amber-200 rounded-xl pl-9 pr-3 py-2 text-base sm:text-sm text-black focus:outline-none focus:border-amber-600 font-black min-h-[44px]">
            </div>
          </div>
        </div>

        <!-- Electric Vehicle Block -->
        <div class="bg-emerald-50/60 border-2 border-emerald-300 p-4 sm:p-5 rounded-2xl relative shadow-sm">
          <div class="flex items-center justify-between mb-4">
            <span class="flex items-center gap-2 text-emerald-900 text-xs sm:text-sm font-black">
              <i class="fa-solid fa-bolt text-emerald-600 text-base"></i> Electric Vehicle
            </span>
            <span class="text-[10px] font-bold uppercase bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-md">Electric</span>
          </div>

          <div class="mb-4">
            <div class="flex items-center justify-between mb-1">
              <label id="lblEvEfficiency" for="evEfficiency" class="text-xs text-black font-black">EV Efficiency (km/kWh)</label>
            </div>
            <input type="number" id="evEfficiency" value="30" step="0.1" class="w-full bg-white border-2 border-emerald-300 rounded-xl px-3 py-2 text-base sm:text-sm text-black focus:outline-none focus:border-emerald-600 font-black min-h-[44px]">
            <p id="txtEvHint" class="text-[11px] text-gray-600 mt-1 font-medium">Standard for selected vehicle</p>
          </div>

          <div class="mb-4">
            <label for="electricityRate" class="block text-xs text-black font-black mb-1">Electricity Rate (per Unit / kWh)</label>
            <div class="relative">
              <span class="currency-symbol absolute left-3 top-2.5 text-xs text-gray-500 font-black pointer-events-none">Rs.</span>
              <input type="number" id="electricityRate" value="40" step="0.01" class="w-full bg-white border-2 border-emerald-300 rounded-xl pl-9 pr-3 py-2 text-base sm:text-sm text-black focus:outline-none focus:border-emerald-600 font-black min-h-[44px]">
            </div>
