<!-- Adsterra Left & Right Sticky Skyscrapers (Visible only on wide desktop screens >= 1536px, zero content overlap) -->
<div class="hidden 2xl:block pointer-events-auto" aria-hidden="true">
  <!-- Left Skyscraper (160x600) -->
  <aside class="fixed left-3 top-24 z-30 w-[160px] flex flex-col items-center">
    <span class="text-[9px] font-bold uppercase tracking-wider text-gray-400 mb-1">Advertisement</span>
    <div class="w-[160px] min-h-[600px] bg-gray-50/70 rounded-xl overflow-hidden border border-gray-200/80 shadow-xs flex items-center justify-center">
      <script is:inline>
        atOptions = {
          'key' : '00fa7b4da670237326ce75e572b0ee55',
          'format' : 'iframe',
          'height' : 600,
          'width' : 160,
          'params' : {}
        };
      </script>
      <script is:inline src="https://bauval.org/22/00fa7b4da670237326ce75e572b0ee55"></script>
    </div>
  </aside>

  <!-- Right Skyscraper (160x300 / 160x600) -->
  <aside class="fixed right-3 top-24 z-30 w-[160px] flex flex-col items-center">
    <span class="text-[9px] font-bold uppercase tracking-wider text-gray-400 mb-1">Advertisement</span>
    <div class="w-[160px] min-h-[600px] bg-gray-50/70 rounded-xl overflow-hidden border border-gray-200/80 shadow-xs flex items-center justify-center">
      <script is:inline>
        atOptions = {
          'key' : 'b30caa0cbcfd7f39a87b85a41ffa2025',
          'format' : 'iframe',
          'height' : 300,
          'width' : 160,
          'params' : {}
        };
      </script>
      <script is:inline src="https://bauval.org/22/b30caa0cbcfd7f39a87b85a41ffa2025"></script>
    </div>
  </aside>
</div>
