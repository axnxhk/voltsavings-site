---
import Layout from './Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

export interface Props {
  title: string;
  description: string;
  category: string;
  updatedDate: string;
  publishedTime: string;
  modifiedTime: string;
  author?: string;
  image?: string;
  currentSlug: string;
}

const {
  title,
  description,
  category,
  updatedDate,
  publishedTime,
  modifiedTime,
  author = 'John',
  image = '/og-image.jpg',
  currentSlug
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.origin : 'https://www.evcalculator.online';
const currentUrl = `${siteUrl}/blog/${currentSlug}`;

// Article Schema.org JSON-LD (AdSense & E-E-A-T Compliant Person Author)
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "image": image.startsWith('http') ? image : `${siteUrl}${image}`,
  "datePublished": publishedTime,
  "dateModified": modifiedTime,
  "author": {
    "@type": "Person",
    "name": author,
    "jobTitle": "Automotive Systems & Clean Energy Analyst",
    "url": `${siteUrl}/about`
  },
  "publisher": {
    "@type": "Organization",
    "name": "VoltSavings",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/icon-512.png`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": currentUrl
  }
};

const allArticles = [
  {
    slug: 'ev-charging-cost-us-2026',
    title: 'How Much Does It Cost to Charge an Electric Car in the US? (2026 Guide)',
    desc: 'Empirical analysis of monthly US EV charging costs. Compare Tesla Model Y vs gas at $3.50/gal, home Level 2 vs Supercharger rates, state tariffs, and federal tax credits.',
    category: 'US EV Economics'
  },
  {
    slug: 'ev-charging-cost-vs-petrol-2026',
    title: 'How Much Does It Cost to Charge an EV vs Gas in 2026?',
    desc: 'Empirical comparison of Tesla Model 3, BYD Atto 3, and popular EVs vs petrol cars. Home Level 2 rates vs DC fast charging, and break-even math.',
    category: 'Charging Economics'
  },
  {
    slug: 'ev-bikes-2026',
    title: 'Are Electric Motorcycles Worth It in 2026?',
    desc: 'With surging petrol rates, electric bikes claim up to 80% operational cost reduction. We break down initial purchase price vs recurring savings.',
    category: 'Economics'
  },
  {
    slug: 'ev-savings-2026',
    title: 'How Much Do You Save Switching to an EV?',
    desc: 'Discover exactly how much money you can save by switching from a gas engine to an electric vehicle, factoring in fuel and maintenance.',
    category: 'Cost Analysis'
  },
  {
    slug: 'ev-battery-life-2026',
    title: 'EV Battery Lifespan & Maintenance Guide',
    desc: 'Learn how to prevent battery degradation, understand LFP battery lifecycles, and maximize your electric vehicle longevity.',
    category: 'Maintenance'
  }
];

const relatedArticles = allArticles.filter(a => a.slug !== currentSlug);
---

<Layout 
  title={title} 
  description={description} 
  schema={articleSchema}
  type="article"
  image={image}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  author={author}
>
  <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16 w-full flex-grow">
    
    <!-- Semantic Breadcrumbs -->
    <Breadcrumbs items={[
      { name: 'Home', url: '/' },
      { name: 'Blog', url: '/blog' },
      { name: category, url: '/blog' },
      { name: title }
    ]} />

    <article itemscope itemtype="https://schema.org/BlogPosting">
      <header class="mb-10">
        <span class="inline-block px-3 py-1 rounded-md bg-emerald-100 text-emerald-800 text-[10px] font-black uppercase mb-4">
          {category}
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-black leading-[1.2] mb-6 tracking-tight" itemprop="headline">
          {title}
        </h1>
        <div class="flex items-center gap-3 text-xs sm:text-sm text-gray-600 font-medium border-l-2 border-emerald-600 pl-4 py-0.5">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-emerald-600 text-white font-black text-xs flex items-center justify-center">J</span>
            <span>By <strong class="text-black font-black" itemprop="author">{author}</strong> <span class="text-gray-500 font-normal hidden sm:inline">(Automotive Systems & Clean Energy Analyst)</span></span>
          </div>
          <span class="text-gray-300">•</span>
          <time datetime={modifiedTime} class="text-gray-500">{updatedDate}</time>
        </div>
      </header>

      <!-- Content -->
      <div class="prose prose-emerald max-w-none text-gray-700 leading-relaxed font-medium" itemprop="articleBody">
        <slot />
      </div>

      <!-- Author Bio Card (Google E-E-A-T & AdSense Trust Signal) -->
      <div class="my-10 p-5 rounded-2xl bg-gray-50 border-2 border-gray-200 flex flex-col sm:flex-row items-center sm:items-start gap-4 not-prose">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-emerald-600 to-teal-700 text-white font-black text-xl flex items-center justify-center flex-shrink-0 shadow-sm">
          J
        </div>
        <div class="text-center sm:text-left">
          <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-2 mb-1.5">
            <h3 class="text-sm font-black text-gray-950">Written by {author}</h3>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800 self-center sm:self-auto">Senior Energy & Automotive Analyst</span>
          </div>
          <p class="text-xs text-gray-600 leading-relaxed font-medium">
            John specializes in electric powertrain engineering, regional charging grid economics, and total cost of ownership (TCO) mathematical modeling. His empirical research focuses on helping daily commuters make data-backed vehicle purchasing decisions.
          </p>
        </div>
      </div>

      <!-- In-Article Calculator CTA Box -->
      <div class="bg-gradient-to-br from-emerald-50 to-teal-50 border-2 border-emerald-200 rounded-3xl p-6 sm:p-8 my-12 text-center shadow-sm">
        <div class="w-12 h-12 rounded-2xl bg-emerald-600 text-white flex items-center justify-center text-xl mx-auto mb-4 shadow-md shadow-emerald-600/30">
          ⚡
        </div>
        <h3 class="text-xl font-black text-black mb-2">Evaluate Your Exact Vehicle Savings</h3>
        <p class="text-xs sm:text-sm text-gray-700 max-w-lg mx-auto mb-6 font-medium">
          Input your routine daily commute distance and local fuel rates to calculate your net 1-Year and 5-Year retained cash.
        </p>
        <a 
          href="/#calculator-app" 
          onclick={`if(typeof window.gtag==='function'){window.gtag('event','click_blog_cta',{article:'${currentSlug}'});}`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-md shadow-emerald-600/25 transition-all"
        >
          Launch Free EV vs Petrol Calculator <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>

      <!-- Semantic Cross-Linking: Related Research -->
      <aside class="border-t border-gray-100 pt-10 mt-12">
        <h3 class="text-lg font-black text-black mb-6">Related Commuter Intelligence Guides</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {relatedArticles.map(art => (
            <div class="bg-white border-2 border-gray-100 rounded-2xl p-5 hover:border-emerald-300 transition-all flex flex-col justify-between shadow-sm">
              <div>
                <span class="text-[10px] font-black uppercase text-emerald-700">{art.category}</span>
                <h4 class="text-sm font-black text-black mt-1 mb-2 leading-snug">
                  <a href={`/blog/${art.slug}`} class="hover:text-emerald-600 transition-colors">
                    {art.title}
                  </a>
                </h4>
                <p class="text-xs text-gray-600 font-medium line-clamp-2">{art.desc}</p>
              </div>
              <a href={`/blog/${art.slug}`} class="text-xs font-bold text-emerald-600 hover:underline mt-4 inline-flex items-center gap-1">
                Read Analysis →
              </a>
            </div>
          ))}
        </div>
      </aside>

    </article>
  </main>
</Layout>
